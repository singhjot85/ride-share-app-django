{# =============================================================================
   Modal Dialog Component Macro
   WAI-ARIA compliant accessible dialog and alertoverlay with backdrop blur,
   focus management, and keyboard dismissal.
   ============================================================================= #}
{% from "core/components/common/icons.jinja" import icon %}
{% macro modal(id, title="", desc="", variant="default", dismissible=true, role="dialog", extra_classes="", icon_name="", icon_size=44, icon_classes="") %}
    <div id="{{ id }}"
         class="ls-modal-overlay ls-modal--{{ variant }}{% if extra_classes %} {{ extra_classes }}{% endif %}"
         style="display: none"
         role="{{ role }}"
         aria-modal="true"
         {% if title %}aria-labelledby="{{ id }}_title"{% endif %}
         {% if desc %}aria-describedby="{{ id }}_desc"{% endif %}
         data-dismissible="{{ 'true' if dismissible else 'false' }}"
         tabindex="-1">
        <div class="ls-modal-backdrop"
             {% if dismissible %}onclick="LoadShareModal.close('{{ id }}')"{% endif %}></div>
        <div class="ls-modal-container">
            <div class="ls-modal-card">
                {% if dismissible %}
                    <button type="button"
                            class="ls-modal-close-btn"
                            onclick="LoadShareModal.close('{{ id }}')"
                            aria-label="Close dialog">{{ icon("close", size=18) }}</button>
                {% endif %}
                {% if icon_name %}
                    <div class="ls-modal-icon">{{ icon(icon_name, size=icon_size, extra_classes=icon_classes) }}</div>
                {% endif %}
                {% if title %}<h3 id="{{ id }}_title" class="ls-modal-title">{{ title }}</h3>{% endif %}
                {% if desc %}<p id="{{ id }}_desc" class="ls-modal-desc">{{ desc }}</p>{% endif %}
                <div class="ls-modal-body">{{ caller() if caller is defined else '' }}</div>
            </div>
        </div>
    </div>
{% endmacro %}
