{# =============================================================================
   Booking Card & Container Component Macro
   Provides modular multi-state booking cards and cards container for
   profile and consignment management.

   Supported Card States:
   - "in_transit" / "transit" / "active": Live on route with tracking badge and pulse
   - "requested" / "pending": Booking created, awaiting dispatch
   - "delivered" / "completed": Finished trip with completion badge
   - "cancelled": Terminated consignment

   Supported Container States:
   - "empty" (Default): Clean empty state panel with call-to-action
   - "populated": List of booking cards with status filters
   ============================================================================= #}
{% from "core/components/common/icons.jinja" import icon %}
{% macro booking_card(code="RTW-7814-DEL", status="in_transit", route_from="Delhi (Sanjay Gandhi TN)", route_to="Jaipur (VKI)", time_label=None, time_label_en=None, time_label_hi=None, price="₹2,125", is_live=false, extra_classes="", labels=None, labels_en=None, labels_hi=None) %}
    {% set lbls = labels if (labels is defined and labels) else {} %}
    {% set lbls_en = labels_en if (labels_en is defined and labels_en) else {} %}
    {% set lbls_hi = labels_hi if (labels_hi is defined and labels_hi) else {} %}
    {% set norm_status = status|lower %}
    {% if norm_status in ["in_transit", "transit", "active"] %}
        {% set filter_status = "active" %}
        {% set badge_class = "badge-status-transit" %}
        {% set status_icon = "local_shipping" %}
        {% set status_title = (lbls.profile_status_in_transit if lbls.profile_status_in_transit is defined else "In Transit") %}
        {% set status_title_en = (lbls_en.profile_status_in_transit if lbls_en.profile_status_in_transit is defined else "In Transit") %}
        {% set status_title_hi = (lbls_hi.profile_status_in_transit if lbls_hi.profile_status_in_transit is defined else "ट्रांजिट में") %}
        {% set time_icon = "schedule" %}
        {% set default_time = (lbls.profile_departure_today if lbls.profile_departure_today is defined else "Departed Today, 06:30 AM") %}
        {% set default_time_en = (lbls_en.profile_departure_today if lbls_en.profile_departure_today is defined else "Departed Today, 06:30 AM") %}
        {% set default_time_hi = (lbls_hi.profile_departure_today if lbls_hi.profile_departure_today is defined else "आज रवाना, 06:30 AM") %}
        {% set has_pulse = true %}
    {% elif norm_status in ["requested", "pending"] %}
        {% set filter_status = "active" %}
        {% set badge_class = "badge-status-requested" %}
        {% set status_icon = "schedule" %}
        {% set status_title = (lbls.profile_status_requested if lbls.profile_status_requested is defined else "Requested") %}
        {% set status_title_en = (lbls_en.profile_status_requested if lbls_en.profile_status_requested is defined else "Requested") %}
        {% set status_title_hi = (lbls_hi.profile_status_requested if lbls_hi.profile_status_requested is defined else "अनुरोध भेजा गया") %}
        {% set time_icon = "calendar_today" %}
        {% set default_time = (lbls.profile_departure_tomorrow if lbls.profile_departure_tomorrow is defined else "Pickup Tomorrow, 09:00 AM") %}
        {% set default_time_en = (lbls_en.profile_departure_tomorrow if lbls_en.profile_departure_tomorrow is defined else "Pickup Tomorrow, 09:00 AM") %}
        {% set default_time_hi = (lbls_hi.profile_departure_tomorrow if lbls_hi.profile_departure_tomorrow is defined else "कल पिकअप, 09:00 AM") %}
        {% set has_pulse = false %}
    {% elif norm_status in ["delivered", "completed"] %}
        {% set filter_status = "completed" %}
        {% set badge_class = "badge-status-delivered" %}
        {% set status_icon = "check_circle" %}
        {% set status_title = (lbls.profile_status_delivered if lbls.profile_status_delivered is defined else "Delivered") %}
        {% set status_title_en = (lbls_en.profile_status_delivered if lbls_en.profile_status_delivered is defined else "Delivered") %}
        {% set status_title_hi = (lbls_hi.profile_status_delivered if lbls_hi.profile_status_delivered is defined else "डिलीवर हो गया") %}
        {% set time_icon = "lock_clock" %}
        {% set default_time = (lbls.profile_delivered_date if lbls.profile_delivered_date is defined else "Delivered 24 Oct, 04:15 PM") %}
        {% set default_time_en = (lbls_en.profile_delivered_date if lbls_en.profile_delivered_date is defined else "Delivered 24 Oct, 04:15 PM") %}
        {% set default_time_hi = (lbls_hi.profile_delivered_date if lbls_hi.profile_delivered_date is defined else "24 अक्टूबर को डिलीवर हुआ") %}
        {% set has_pulse = false %}
    {% else %}
        {% set filter_status = "completed" %}
        {% set badge_class = "bg-surface-container text-on-surface-variant border border-outline-variant/60" %}
        {% set status_icon = "info" %}
        {% set status_title = norm_status|title %}
        {% set status_title_en = norm_status|title %}
        {% set status_title_hi = norm_status|title %}
        {% set time_icon = "event" %}
        {% set default_time = "" %}
        {% set default_time_en = "" %}
        {% set default_time_hi = "" %}
        {% set has_pulse = false %}
    {% endif %}
    <article class="booking-item bg-surface-container-lowest border border-outline-variant/60 rounded-xl p-4 shadow-sm hover:border-primary transition-all cursor-pointer{% if extra_classes %} {{ extra_classes }}{% endif %}"
             data-status="{{ filter_status }}"
             data-card-state="{{ norm_status }}">
        <div class="flex items-center justify-between pb-2 mb-2 border-b border-outline-variant/30">
            <span class="font-mono font-bold text-sm text-primary tracking-wide flex items-center gap-2">
                {% if has_pulse %}<span class="live-dot-pulse"></span>{% endif %}
                {{ code }}
            </span>
            <span class="{{ badge_class }} text-[11px] font-mono px-2.5 py-0.5 rounded-full flex items-center gap-1 font-semibold">
                {{ icon(status_icon, size=14) }}
                <span class="lang-text"
                      data-en="{{ status_title_en }}"
                      data-hi="{{ status_title_hi }}">{{ status_title }}</span>
            </span>
        </div>
        <p class="text-xs font-semibold text-primary">{{ route_from }} → {{ route_to }}</p>
        <div class="mt-2.5 pt-2 flex items-center justify-between text-on-surface-variant text-xs">
            <div class="flex items-center gap-1">
                <span class="text-outline flex items-center">{{ icon(time_icon, size=14) }}</span>
                <span class="font-mono lang-text"
                      data-en="{{ time_label_en or default_time_en }}"
                      data-hi="{{ time_label_hi or default_time_hi }}">{{ time_label or default_time }}</span>
            </div>
            {% if price %}<span class="font-mono font-bold text-sm text-primary">{{ price }}</span>{% endif %}
        </div>
    </article>
{% endmacro %}
{% macro booking_empty_state(id="booking-empty-state", is_hidden=false, extra_classes="", labels=None, labels_en=None, labels_hi=None) %}
    {% set lbls = labels if (labels is defined and labels) else {} %}
    {% set lbls_en = labels_en if (labels_en is defined and labels_en) else {} %}
    {% set lbls_hi = labels_hi if (labels_hi is defined and labels_hi) else {} %}
    <div class="bg-surface-container-lowest border border-dashed border-outline-variant rounded-2xl p-8 text-center flex flex-col items-center justify-center my-2 space-y-3{% if is_hidden %} hidden{% endif %}{% if extra_classes %} {{ extra_classes }}{% endif %}"
         id="{{ id }}"
         data-state="empty">
        <div class="w-14 h-14 rounded-full bg-surface-container flex items-center justify-center mx-auto text-on-surface-variant">
            {{ icon("inventory_2", size=28) }}
        </div>
        <div>
            <h3 class="text-base font-bold text-primary font-mono lang-text"
                data-en="{{ (lbls_en.profile_no_bookings_title if lbls_en.profile_no_bookings_title is defined else 'No bookings yet') }}"
                data-hi="{{ (lbls_hi.profile_no_bookings_title if lbls_hi.profile_no_bookings_title is defined else 'अभी कोई बुकिंग नहीं है') }}">
                {{ (lbls.profile_no_bookings_title if lbls.profile_no_bookings_title is defined else "No bookings yet") }}
            </h3>
            <p class="text-xs text-on-surface-variant max-w-xs mx-auto mt-1 lang-text"
               data-en="{{ (lbls_en.profile_no_bookings_desc if lbls_en.profile_no_bookings_desc is defined else 'Your route dispatches will appear here once booked.') }}"
               data-hi="{{ (lbls_hi.profile_no_bookings_desc if lbls_hi.profile_no_bookings_desc is defined else 'आपकी रूट बुकिंग यहां प्रदर्शित होगी।') }}">
                {{ (lbls.profile_no_bookings_desc if lbls.profile_no_bookings_desc is defined else "Your route dispatches will appear here once booked.") }}
            </p>
        </div>
        <button type="button"
                onclick="LoadShareNav.switchTab('book-corridor')"
                class="bg-secondary text-on-secondary px-4 py-2 rounded-xl inline-flex items-center gap-2 hover:bg-secondary-container transition-colors shadow-xs active:scale-95 text-xs font-bold font-mono">
            {{ icon("add_box", size=16) }}
            <span class="lang-text"
                  data-en="{{ (lbls_en.btn_book_delivery if lbls_en.btn_book_delivery is defined else 'Book Delivery') }}"
                  data-hi="{{ (lbls_hi.btn_book_delivery if lbls_hi.btn_book_delivery is defined else 'पार्सल भेजें') }}">
                {{ (lbls.btn_book_delivery if lbls.btn_book_delivery is defined else "Book Delivery") }}
            </span>
        </button>
    </div>
{% endmacro %}
{% macro booking_cards_container(id="booking-cards-container", active_state="empty", bookings=None, extra_classes="", labels=None, labels_en=None, labels_hi=None) %}
    {% set lbls = labels if (labels is defined and labels) else {} %}
    {% set lbls_en = labels_en if (labels_en is defined and labels_en) else {} %}
    {% set lbls_hi = labels_hi if (labels_hi is defined and labels_hi) else {} %}
    {% set is_empty = (active_state == "empty") %}
    <div class="booking-cards-container{% if extra_classes %} {{ extra_classes }}{% endif %}"
         id="{{ id }}"
         data-active-state="{{ active_state }}">
        <!-- 1. Populated Cards List Panel -->
        <div class="space-y-3 pt-1{% if is_empty %} hidden{% endif %}"
             id="booking-cards-list"
             data-state="populated">
            {% if bookings %}
                {% for b in bookings %}
                    {{ booking_card(code=b.code,
                                        status=b.status,
                                        route_from=b.route_from,
                                        route_to=b.route_to,
                                        time_label=b.time_label,
                                        time_label_en=b.time_label_en,
                                        time_label_hi=b.time_label_hi,
                                        price=b.price,
                                        is_live=b.is_live,
                                        labels=lbls,
                                        labels_en=lbls_en,
                                        labels_hi=lbls_hi) }}
                {% endfor %}
            {% elif caller %}
                {{ caller() }}
            {% else %}
                {# Standard Multi-State Sample Booking Cards #}
                {{ booking_card(code="RTW-7814-DEL",
                                status="in_transit",
                                route_from="Delhi (Sanjay Gandhi TN)",
                                route_to="Jaipur (VKI)",
                                price="₹2,125",
                                is_live=true,
                                labels=lbls,
                                labels_en=lbls_en,
                                labels_hi=lbls_hi) }}
                {{ booking_card(code="RTW-7902-JPR",
                                status="requested",
                                route_from="Jaipur (VKI)",
                                route_to="Delhi (Sanjay Gandhi TN)",
                                price="₹850",
                                labels=lbls,
                                labels_en=lbls_en,
                                labels_hi=lbls_hi) }}
                {{ booking_card(code="RTW-6420-DEL",
                                status="delivered",
                                route_from="Delhi (Sanjay Gandhi TN)",
                                route_to="Jaipur (VKI)",
                                price="₹3,400",
                                labels=lbls,
                                labels_en=lbls_en,
                                labels_hi=lbls_hi) }}
            {% endif %}
        </div>
        <!-- 2. Empty State Panel (Default Active State) -->
        {{ booking_empty_state(id="booking-empty-state", is_hidden=not is_empty, labels=lbls, labels_en=lbls_en, labels_hi=lbls_hi) }}
    </div>
{% endmacro %}
