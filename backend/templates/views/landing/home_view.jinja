{# Home View Shell: Sourced faithfully from local_data/design/user-facing/01_landing_page.html #}
{% from "core/components/common/icons.jinja" import icon %}
{% from "components/state_card.jinja" import state_container, state_panel %}
{% from "components/accordion.jinja" import accordion, accordion_item %}
{% from "components/filter_chips.jinja" import filter_chips, filter_chip %}
<section id="view-home"
         class="landing-tab-view active"
         aria-labelledby="home-hero-title">
    <div class="landing-view-container max-w-2xl lg:max-w-5xl mx-auto px-4 pt-6 pb-20 space-y-12 text-left">
        <!-- ========================================================================= -->
        <!-- 1. HERO SECTION & 2. TRACKER PREVIEW (RESPONSIVE SPLIT GRID)              -->
        <!-- ========================================================================= -->
        <section class="hero-screen-section grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 items-center py-4 lg:py-6">
            <div class="space-y-6">
                <div class="space-y-3">
                    <div class="inline-flex items-center gap-2 bg-surface-container px-3 py-1 rounded-full text-xs font-medium text-secondary">
                        {{ icon("campaign", size=16, extra_classes="text-secondary") }}
                        <span class="lang-text"
                              data-en="{{ labels_en.pilot_notice }}"
                              data-hi="{{ labels_hi.pilot_notice }}">{{ labels.pilot_notice }}</span>
                    </div>
                    <h1 id="home-hero-title"
                        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-primary tracking-tight">
                        <span class="lang-text"
                              data-en="{{ labels_en.hero_headline }}"
                              data-hi="{{ labels_hi.hero_headline }}">{{ labels.hero_headline }}</span>
                    </h1>
                    <p class="text-base sm:text-lg text-on-surface-variant leading-relaxed">
                        <span class="lang-text"
                              data-en="{{ labels_en.hero_subtitle }}"
                              data-hi="{{ labels_hi.hero_subtitle }}">{{ labels.hero_subtitle }}</span>
                    </p>
                </div>
                <!-- Action Buttons -->
                <div class="flex flex-col sm:flex-row gap-3 pt-1">
                    <button type="button"
                            class="btn-cta-primary"
                            onclick="LoadShareNav.switchTab('book-corridor')">
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_book_delivery }}"
                              data-hi="{{ labels_hi.btn_book_delivery }}">{{ labels.btn_book_delivery }}</span>
                        {{ icon("arrow_forward", size=18) }}
                    </button>
                    <button type="button"
                            class="btn-cta-secondary"
                            onclick="LoadShareNav.switchTab('rates')">
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_see_rates }}"
                              data-hi="{{ labels_hi.btn_see_rates }}">{{ labels.btn_see_rates }}</span>
                    </button>
                </div>
            </div>
            <!-- ========================================================================= -->
            <!-- 2. TRACKER PREVIEW (TRUCK & HIGHWAY SCHEMATIC CANVAS)                     -->
            <!-- ========================================================================= -->
            <div class="space-y-2.5">
                <!-- State Switcher Controls -->
                <div class="flex items-center justify-between text-xs px-1">
                    <span class="text-on-surface-variant font-bold uppercase tracking-wider text-[11px] lang-text"
                          data-en="{{ labels_en.tracker_preview }}"
                          data-hi="{{ labels_hi.tracker_preview }}">{{ labels.tracker_preview }}</span>
                    {% call filter_chips(id="tracker-state-switcher", on_change="LoadShareNav.setDispatchState", variant="segmented", size="sm") %}
                        {{ filter_chip(id="btn-state-dispatch", value="active", label=labels.btn_item_in_dispatch, label_en=labels_en.btn_item_in_dispatch, label_hi=labels_hi.btn_item_in_dispatch, is_active=true) }}
                        {{ filter_chip(id="btn-state-loading", value="loading", label=labels.btn_loading_state, label_en=labels_en.btn_loading_state, label_hi=labels_hi.btn_loading_state) }}
                        {{ filter_chip(id="btn-state-empty", value="empty", label=labels.btn_empty_state, label_en=labels_en.btn_empty_state, label_hi=labels_hi.btn_empty_state) }}
                    {% endcall %}
                </div>
                {% call state_container(id="tracker-preview-container", active_state="active") %}
                    <!-- 1. State: Active Dispatch -->
                    {% call state_panel(id="state-active-dispatch", state="active", is_active=true, extra_classes="w-full bg-gradient-to-b from-primary via-primary to-primary-container rounded-2xl p-5 text-on-primary relative overflow-hidden shadow-md border border-outline-variant/20") %}
                        <div class="flex justify-between items-center text-xs text-surface-variant mb-5">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span class="tracking-wide font-semibold lang-text"
                                      data-en="{{ labels_en.dispatch_status }}"
                                      data-hi="{{ labels_hi.dispatch_status }}">{{ labels.dispatch_status }}</span>
                                <span class="badge-telemetry font-mono text-[10px] hidden sm:inline-flex">HR 55 AH 7824</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="badge-telemetry font-mono text-[10px] hidden sm:inline-flex">62 km/h</span>
                                <span class="font-mono text-secondary-fixed bg-primary-container/80 px-2 py-0.5 rounded text-[11px] lang-text"
                                      data-en="{{ labels_en.dispatch_transit }}"
                                      data-hi="{{ labels_hi.dispatch_transit }}">{{ labels.dispatch_transit }}</span>
                            </div>
                        </div>
                        <div class="relative py-4">
                            <div class="flex justify-between items-center text-[10px] font-mono text-surface-variant/75 mb-1.5">
                                <span>0 km (SGTN Bay 4)</span>
                                <span class="text-secondary-fixed font-semibold">NH48 Toll Gantry (178 km)</span>
                                <span>268 km (VKIA Bay 2)</span>
                            </div>
                            <div class="h-1.5 bg-primary-container rounded-full w-full relative overflow-hidden">
                                <div class="absolute inset-y-0 left-0 w-2/3 bg-secondary-container rounded-full"></div>
                            </div>
                            {# <div class="border-b border-dashed border-outline/30 my-3"></div> #}
                            <div class="flex justify-between items-end mt-4">
                                <div class="text-left">
                                    <span class="text-[11px] text-surface-variant block uppercase lang-text"
                                          data-en="{{ labels_en.origin_hub_title }}"
                                          data-hi="{{ labels_hi.origin_hub_title }}">{{ labels.origin_hub_title }}</span>
                                    <p class="text-lg sm:text-xl font-bold text-on-primary lang-text"
                                       data-en="{{ labels_en.origin_city }}"
                                       data-hi="{{ labels_hi.origin_city }}">{{ labels.origin_city }}</p>
                                    <span class="text-xs text-surface-variant/80 lang-text"
                                          data-en="{{ labels_en.origin_hub_name }}"
                                          data-hi="{{ labels_hi.origin_hub_name }}">{{ labels.origin_hub_name }}</span>
                                </div>
                                <div class="flex flex-col items-center pb-1">
                                    <div class="w-10 h-10 rounded-full bg-secondary flex items-center justify-center text-on-primary shadow-md">
                                        {{ icon("local_shipping", size=24) }}
                                    </div>
                                    <span class="font-mono text-[11px] text-secondary-fixed mt-1 lang-text"
                                          data-en="{{ labels_en.corridor_badge }}"
                                          data-hi="{{ labels_hi.corridor_badge }}">{{ labels.corridor_badge }}</span>
                                </div>
                                <div class="text-right">
                                    <span class="text-[11px] text-surface-variant block uppercase lang-text"
                                          data-en="{{ labels_en.destination_hub_title }}"
                                          data-hi="{{ labels_hi.destination_hub_title }}">{{ labels.destination_hub_title }}</span>
                                    <p class="text-lg sm:text-xl font-bold text-on-primary lang-text"
                                       data-en="{{ labels_en.destination_city }}"
                                       data-hi="{{ labels_hi.destination_city }}">{{ labels.destination_city }}</p>
                                    <span class="text-xs text-surface-variant/80 lang-text"
                                          data-en="{{ labels_en.destination_hub_name }}"
                                          data-hi="{{ labels_hi.destination_hub_name }}">{{ labels.destination_hub_name }}</span>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-outline-variant/20 flex items-center justify-between text-xs text-surface-dim">
                            <span>
                                <span class="lang-text"
                                      data-en="{{ labels_en.departs_label }}"
                                      data-hi="{{ labels_hi.departs_label }}">{{ labels.departs_label }}</span>
                                <strong class="font-mono text-on-primary">{{ labels.departure_time }}</strong>
                            </span>
                            <span class="hidden sm:inline-flex items-center gap-1 font-mono text-[11px] text-secondary-fixed">
                                {{ icon("toll", size=14) }}
                                <span>Shahjahanpur Cleared</span>
                            </span>
                            <span>
                                <span class="lang-text"
                                      data-en="{{ labels_en.arrival_label }}"
                                      data-hi="{{ labels_hi.arrival_label }}">{{ labels.arrival_label }}</span>
                                <strong class="font-mono text-on-primary">{{ labels.arrival_time }}</strong>
                            </span>
                        </div>
                    {% endcall %}
                    <!-- 2. State: Loading Skeleton -->
                    {% call state_panel(id="state-skeleton-dispatch", state="loading", is_active=false, extra_classes="w-full bg-gradient-to-b from-primary via-primary to-primary-container rounded-2xl p-5 text-on-primary relative overflow-hidden shadow-md border border-outline-variant/20 animate-pulse") %}
                        <div class="flex justify-between items-center mb-5">
                            <div class="flex items-center gap-2">
                                <div class="w-2 h-2 rounded-full bg-primary-container/80"></div>
                                <div class="h-3.5 w-36 bg-primary-container/80 rounded"></div>
                                <div class="h-4 w-20 bg-primary-container/80 rounded-full hidden sm:inline-block"></div>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <div class="h-4 w-14 bg-primary-container/80 rounded-full hidden sm:inline-block"></div>
                                <div class="h-5 w-20 bg-primary-container/80 rounded"></div>
                            </div>
                        </div>
                        <div class="relative py-4 space-y-4">
                            <div class="flex justify-between items-center text-[10px] mb-1.5">
                                <div class="h-2.5 w-20 bg-primary-container/80 rounded"></div>
                                <div class="h-2.5 w-32 bg-primary-container/80 rounded"></div>
                                <div class="h-2.5 w-20 bg-primary-container/80 rounded"></div>
                            </div>
                            <div class="h-1.5 bg-primary-container/80 rounded-full w-full"></div>
                            {# <div class="border-b border-dashed border-outline/30 my-3"></div> #}
                            <div class="flex justify-between items-end mt-4">
                                <div class="space-y-1.5 text-left">
                                    <div class="h-3 w-16 bg-primary-container/80 rounded"></div>
                                    <div class="h-6 w-24 bg-primary-container/80 rounded"></div>
                                    <div class="h-3 w-28 bg-primary-container/80 rounded"></div>
                                </div>
                                <div class="flex flex-col items-center pb-1 gap-1">
                                    <div class="w-10 h-10 rounded-full bg-primary-container/80"></div>
                                    <div class="h-3 w-16 bg-primary-container/80 rounded"></div>
                                </div>
                                <div class="space-y-1.5 text-right flex flex-col items-end">
                                    <div class="h-3 w-16 bg-primary-container/80 rounded"></div>
                                    <div class="h-6 w-24 bg-primary-container/80 rounded"></div>
                                    <div class="h-3 w-28 bg-primary-container/80 rounded"></div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-outline-variant/20 flex items-center justify-between">
                            <div class="h-3.5 w-32 bg-primary-container/80 rounded"></div>
                            <div class="h-3.5 w-28 bg-primary-container/80 rounded hidden sm:block"></div>
                            <div class="h-3.5 w-28 bg-primary-container/80 rounded"></div>
                        </div>
                    {% endcall %}
                    <!-- 3. State: No item in dispatch (Empty State) -->
                    {% call state_panel(id="state-empty-dispatch", state="empty", is_active=false, extra_classes="w-full bg-surface-container-lowest rounded-2xl p-6 text-on-surface text-center relative overflow-hidden shadow-xs border border-outline-variant/40 space-y-4") %}
                        <div class="w-14 h-14 rounded-full bg-surface-container mx-auto flex items-center justify-center text-on-surface-variant">
                            {{ icon("inventory_2", size=28) }}
                        </div>
                        <div class="space-y-1">
                            <h4 class="text-lg font-bold text-primary lang-text"
                                data-en="{{ labels_en.empty_dispatch_title }}"
                                data-hi="{{ labels_hi.empty_dispatch_title }}">{{ labels.empty_dispatch_title }}</h4>
                            <p class="text-xs text-on-surface-variant max-w-sm mx-auto leading-relaxed lang-text"
                               data-en="{{ labels_en.empty_dispatch_desc }}"
                               data-hi="{{ labels_hi.empty_dispatch_desc }}">{{ labels.empty_dispatch_desc }}</p>
                        </div>
                        <div class="pt-1">
                            <button type="button"
                                    class="inline-flex items-center justify-center gap-2 h-10 px-5 rounded-xl bg-secondary hover:bg-secondary/90 text-on-secondary font-semibold text-xs shadow-xs transition-all active:scale-[0.98]"
                                    onclick="LoadShareNav.switchTab('book-corridor')">
                                <span class="lang-text"
                                      data-en="{{ labels_en.btn_book_parcel }}"
                                      data-hi="{{ labels_hi.btn_book_parcel }}">{{ labels.btn_book_parcel }}</span>
                                {{ icon("arrow_forward", size=16) }}
                            </button>
                        </div>
                    {% endcall %}
                {% endcall %}
            </div>
        </section>
        <!-- ========================================================================= -->
        <!-- 3. TRANSIT GUARANTEES & SAFETY PROTOCOL                                   -->
        <!-- ========================================================================= -->
        <div class="p-4 bg-surface-container-low/80 rounded-2xl border border-outline-variant/30 space-y-3">
            <div class="flex items-center justify-between border-b border-outline-variant/20 pb-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-on-surface-variant flex items-center gap-1.5">
                    {{ icon("verified_user", size=16, extra_classes="text-secondary") }}
                    <span class="lang-text"
                          data-en="{{ labels_en.transit_guarantees_title }}"
                          data-hi="{{ labels_hi.transit_guarantees_title }}">{{ labels.transit_guarantees_title }}</span>
                </span>
                <div class="w-6 h-6 rounded-full bg-secondary flex items-center justify-center text-on-primary shadow-xs">
                    {{ icon("verified", size=16) }}
                </div>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-left">
                <div class="space-y-0.5">
                    <div class="flex items-center gap-1.5 text-primary text-xs font-semibold">
                        {{ icon("pin", size=16, extra_classes="text-secondary") }}
                        <span class="lang-text"
                              data-en="{{ labels_en.guarantee_1_title }}"
                              data-hi="{{ labels_hi.guarantee_1_title }}">{{ labels.guarantee_1_title }}</span>
                    </div>
                    <p class="text-[11px] text-on-surface-variant leading-tight lang-text"
                       data-en="{{ labels_en.guarantee_1_desc }}"
                       data-hi="{{ labels_hi.guarantee_1_desc }}">{{ labels.guarantee_1_desc }}</p>
                </div>
                <div class="space-y-0.5">
                    <div class="flex items-center gap-1.5 text-primary text-xs font-semibold">
                        {{ icon("task_alt", size=16, extra_classes="text-secondary") }}
                        <span class="lang-text"
                              data-en="{{ labels_en.guarantee_2_title }}"
                              data-hi="{{ labels_hi.guarantee_2_title }}">{{ labels.guarantee_2_title }}</span>
                    </div>
                    <p class="text-[11px] text-on-surface-variant leading-tight lang-text"
                       data-en="{{ labels_en.guarantee_2_desc }}"
                       data-hi="{{ labels_hi.guarantee_2_desc }}">{{ labels.guarantee_2_desc }}</p>
                </div>
                <div class="space-y-0.5">
                    <div class="flex items-center gap-1.5 text-primary text-xs font-semibold">
                        {{ icon("badge", size=16, extra_classes="text-secondary") }}
                        <span class="lang-text"
                              data-en="{{ labels_en.guarantee_3_title }}"
                              data-hi="{{ labels_hi.guarantee_3_title }}">{{ labels.guarantee_3_title }}</span>
                    </div>
                    <p class="text-[11px] text-on-surface-variant leading-tight lang-text"
                       data-en="{{ labels_en.guarantee_3_desc }}"
                       data-hi="{{ labels_hi.guarantee_3_desc }}">{{ labels.guarantee_3_desc }}</p>
                </div>
                <div class="space-y-0.5">
                    <div class="flex items-center gap-1.5 text-primary text-xs font-semibold">
                        {{ icon("notifications_active", size=16, extra_classes="text-secondary") }}
                        <span class="lang-text"
                              data-en="{{ labels_en.guarantee_4_title }}"
                              data-hi="{{ labels_hi.guarantee_4_title }}">{{ labels.guarantee_4_title }}</span>
                    </div>
                    <p class="text-[11px] text-on-surface-variant leading-tight lang-text"
                       data-en="{{ labels_en.guarantee_4_desc }}"
                       data-hi="{{ labels_hi.guarantee_4_desc }}">{{ labels.guarantee_4_desc }}</p>
                </div>
            </div>
        </div>
        <!-- ========================================================================= -->
        <!-- 4. HOW IT WORKS                                                           -->
        <!-- ========================================================================= -->
        <section class="space-y-4">
            <div class="space-y-1">
                <h2 class="text-xl sm:text-2xl font-bold text-primary lang-text"
                    data-en="{{ labels_en.how_it_works_title }}"
                    data-hi="{{ labels_hi.how_it_works_title }}">{{ labels.how_it_works_title }}</h2>
                <p class="text-sm text-on-surface-variant lang-text"
                   data-en="{{ labels_en.how_it_works_subtitle }}"
                   data-hi="{{ labels_hi.how_it_works_subtitle }}">{{ labels.how_it_works_subtitle }}</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
                <!-- Step 1 -->
                <div class="p-4 bg-surface-container-lowest rounded-2xl border border-outline-variant/40 flex flex-col justify-between gap-3 shadow-xs">
                    <div class="flex items-center justify-between">
                        <div class="w-10 h-10 rounded-xl bg-surface-container flex-shrink-0 flex items-center justify-center text-primary">
                            {{ icon("edit_calendar", size=24) }}
                        </div>
                        <span class="font-mono font-bold text-xs text-secondary bg-surface-container px-2 py-0.5 rounded-full">{{ labels.step_1_num }}</span>
                    </div>
                    <div class="space-y-1">
                        <h3 class="text-base font-bold text-primary lang-text"
                            data-en="{{ labels_en.step_1_title }}"
                            data-hi="{{ labels_hi.step_1_title }}">{{ labels.step_1_title }}</h3>
                        <p class="text-xs text-on-surface-variant leading-relaxed lang-text"
                           data-en="{{ labels_en.step_1_desc }}"
                           data-hi="{{ labels_hi.step_1_desc }}">{{ labels.step_1_desc }}</p>
                    </div>
                </div>
                <!-- Step 2 -->
                <div class="p-4 bg-surface-container-lowest rounded-2xl border border-outline-variant/40 flex flex-col justify-between gap-3 shadow-xs">
                    <div class="flex items-center justify-between">
                        <div class="w-10 h-10 rounded-xl bg-surface-container flex-shrink-0 flex items-center justify-center text-primary">
                            {{ icon("local_shipping", size=24) }}
                        </div>
                        <span class="font-mono font-bold text-xs text-secondary bg-surface-container px-2 py-0.5 rounded-full">{{ labels.step_2_num }}</span>
                    </div>
                    <div class="space-y-1">
                        <h3 class="text-base font-bold text-primary lang-text"
                            data-en="{{ labels_en.step_2_title }}"
                            data-hi="{{ labels_hi.step_2_title }}">{{ labels.step_2_title }}</h3>
                        <p class="text-xs text-on-surface-variant leading-relaxed lang-text"
                           data-en="{{ labels_en.step_2_desc }}"
                           data-hi="{{ labels_hi.step_2_desc }}">{{ labels.step_2_desc }}</p>
                    </div>
                </div>
                <!-- Step 3 -->
                <div class="p-4 bg-surface-container-lowest rounded-2xl border border-outline-variant/40 flex flex-col justify-between gap-3 shadow-xs">
                    <div class="flex items-center justify-between">
                        <div class="w-10 h-10 rounded-xl bg-surface-container flex-shrink-0 flex items-center justify-center text-primary">
                            {{ icon("verified_user", size=24) }}
                        </div>
                        <span class="font-mono font-bold text-xs text-secondary bg-surface-container px-2 py-0.5 rounded-full">{{ labels.step_3_num }}</span>
                    </div>
                    <div class="space-y-1">
                        <h3 class="text-base font-bold text-primary lang-text"
                            data-en="{{ labels_en.step_3_title }}"
                            data-hi="{{ labels_hi.step_3_title }}">{{ labels.step_3_title }}</h3>
                        <p class="text-xs text-on-surface-variant leading-relaxed lang-text"
                           data-en="{{ labels_en.step_3_desc }}"
                           data-hi="{{ labels_hi.step_3_desc }}">{{ labels.step_3_desc }}</p>
                    </div>
                </div>
            </div>
        </section>
        <!-- ========================================================================= -->
        <!-- 5. COLLAPSIBLE FAQS (Native HTML <details>, Zero JS Required)               -->
        <!-- ========================================================================= -->
        <section class="space-y-3">
            <div class="space-y-1">
                <h2 class="text-xl sm:text-2xl font-bold text-primary lang-text"
                    data-en="{{ labels_en.faq_title }}"
                    data-hi="{{ labels_hi.faq_title }}">{{ labels.faq_title }}</h2>
                <p class="text-sm text-on-surface-variant lang-text"
                   data-en="{{ labels_en.faq_subtitle }}"
                   data-hi="{{ labels_hi.faq_subtitle }}">{{ labels.faq_subtitle }}</p>
            </div>
            {% call accordion(id="faq-accordion", variant="separated") %}
                <!-- FAQ 1 -->
                {% call accordion_item(
                    title=labels.faq_1_q,
                    title_en=labels_en.faq_1_q,
                    title_hi=labels_hi.faq_1_q,
                    variant="card"
                    ) %}
                    <span class="lang-text"
                          data-en="{{ labels_en.faq_1_a }}"
                          data-hi="{{ labels_hi.faq_1_a }}">{{ labels.faq_1_a }}</span>
                {% endcall %}
                <!-- FAQ 2 -->
                {% call accordion_item(
                    title=labels.faq_2_q,
                    title_en=labels_en.faq_2_q,
                    title_hi=labels_hi.faq_2_q,
                    variant="card"
                    ) %}
                    <span class="lang-text"
                          data-en="{{ labels_en.faq_2_a }}"
                          data-hi="{{ labels_hi.faq_2_a }}">{{ labels.faq_2_a }}</span>
                {% endcall %}
                <!-- FAQ 3 -->
                {% call accordion_item(
                    title=labels.faq_3_q,
                    title_en=labels_en.faq_3_q,
                    title_hi=labels_hi.faq_3_q,
                    variant="card"
                    ) %}
                    <span class="lang-text"
                          data-en="{{ labels_en.faq_3_a }}"
                          data-hi="{{ labels_hi.faq_3_a }}">{{ labels.faq_3_a }}</span>
                {% endcall %}
                <!-- FAQ 4 -->
                {% call accordion_item(
                    title=labels.faq_4_q,
                    title_en=labels_en.faq_4_q,
                    title_hi=labels_hi.faq_4_q,
                    variant="card"
                    ) %}
                    <span class="lang-text"
                          data-en="{{ labels_en.faq_4_a }}"
                          data-hi="{{ labels_hi.faq_4_a }}">{{ labels.faq_4_a }}</span>
                {% endcall %}
            {% endcall %}
        </section>
        <!-- ========================================================================= -->
        <!-- 6. CLEAN FOOTER                                                           -->
        <!-- ========================================================================= -->
        <footer class="landing-footer w-full bg-gradient-to-b from-primary via-primary to-primary-container rounded-2xl border border-outline-variant/20 py-8 px-6 space-y-6 relative overflow-hidden shadow-md text-on-primary">
            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    {{ icon("local_shipping", size=24, extra_classes="text-secondary-fixed") }}
                    <span class="text-xl font-bold text-on-primary tracking-tight lang-text"
                          data-en="{{ labels_en.brand_name }}"
