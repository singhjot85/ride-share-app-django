{# Profile View Placeholder #}
{% from "core/components/common/icons.jinja" import icon %}
<section id="view-profile"
         class="landing-tab-view hidden"
         aria-labelledby="profile-view-title">
    <div class="landing-view-container max-w-2xl mx-auto px-4 pt-12 pb-20 text-center">
        <div class="coming-soon-card bg-surface-container-lowest border border-outline-variant/60 rounded-3xl p-10 shadow-sm space-y-4">
            <div class="w-16 h-16 rounded-2xl bg-surface-container text-secondary flex items-center justify-center mx-auto shadow-inner">
                {{ icon("account_circle", size=32) }}
            </div>
            <h1 id="profile-view-title" class="text-2xl font-bold text-primary">Sender Business Profile</h1>
            <p class="text-sm text-on-surface-variant max-w-md mx-auto leading-relaxed">
                Manage business GSTIN, saved pickup/drop hubs, past consignments, and e-waybill generation history.
            </p>
            <div class="pt-4">
                <button type="button"
                        class="btn-cta-secondary"
                        onclick="LoadShareNav.switchTab('home')">Back to Overview</button>
            </div>
        </div>
    </div>
</section>
