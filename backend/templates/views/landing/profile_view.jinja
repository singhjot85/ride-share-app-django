{# Sender Profile & Consignment History View #}
{% from "core/components/common/icons.jinja" import icon %}
{% from "components/filter_chips.jinja" import filter_chips, filter_chip %}
{% from "components/context_bar.jinja" import context_bar, context_back_btn %}
{% from "components/modal.jinja" import modal %}
{% from "components/booking_card.jinja" import booking_cards_container, booking_card, booking_empty_state with context %}
{% from "components/customer_card.jinja" import customer_card with context %}
{% set current_user = user if user is defined and user else (request.user if request is defined and request.user is defined else None) %}
{% set customer_inst = customer if customer is defined and customer else None %}
{% set customer_primary_phone = (customer_inst.phones.all()|selectattr("is_primary")|map(attribute="phone")|first) if (customer_inst and customer_inst.phones.exists()) else ((customer_inst.phones.all()|map(attribute="phone")|first) if (customer_inst and customer_inst.phones.exists()) else (current_user.phone_number if current_user and current_user.phone_number else (phone if phone is defined and phone else ''))) %}
{% set customer_primary_email = (customer_inst.emails.all()|selectattr("is_primary")|map(attribute="email")|first) if (customer_inst and customer_inst.emails.exists()) else ((customer_inst.emails.all()|map(attribute="email")|first) if (customer_inst and customer_inst.emails.exists()) else (current_user.email if current_user and current_user.email else '')) %}
{% set user_display_name = (customer_inst.business_name if customer_inst and customer_inst.business_name else (customer_inst.full_name if customer_inst and customer_inst.full_name else None)) or (current_user.get_full_name() if current_user and current_user.get_full_name is defined and current_user.get_full_name() else (current_user.username if current_user and current_user.username is defined else '')) %}
{% set user_display_phone = customer_primary_phone %}
{% set user_display_email = customer_primary_email %}
<section id="view-profile"
         class="landing-tab-view hidden"
         aria-label="Profile"
         data-customer-id="{{ customer_inst.id if customer_inst else '' }}">
    <div class="landing-view-container max-w-2xl mx-auto px-4 md:px-8 py-5 space-y-6">
        <!-- ========================================================================= -->
        <!-- 1. PROFILE CONTEXT BAR (Back link + Quick Action) -->
        <!-- ========================================================================= -->
        {% call context_bar(id="profile-context-bar", variant="flat") %}
            <div class="context-bar-left">
                {{ context_back_btn(label=labels.corridor_back_home, label_en=labels_en.corridor_back_home, label_hi=labels_hi.corridor_back_home, on_click="LoadShareNav.switchTab('home')", icon_size=16) }}
            </div>
            <div class="context-bar-right">
                <button type="button"
                        onclick="LoadShareNav.switchTab('book-corridor')"
                        class="bg-secondary text-on-secondary px-3 py-1.5 rounded-lg text-xs font-bold transition-all shadow-xs flex items-center gap-1.5 active:scale-95">
                    {{ icon("add_box", size=16) }}
                    <span class="lang-text"
                          data-en="{{ labels_en.profile_book_delivery_btn }}"
                          data-hi="{{ labels_hi.profile_book_delivery_btn }}">{{ labels.profile_book_delivery_btn }}</span>
                </button>
            </div>
        {% endcall %}
        <!-- ========================================================================= -->
        <!-- 2. CUSTOMER CARD COMPONENT -->
        <!-- ========================================================================= -->
        {{ customer_card(customer=customer_inst, user=current_user, allow_edit=true, allow_maximize=true, labels=labels, labels_en=labels_en, labels_hi=labels_hi) }}
        <!-- ========================================================================= -->
        <!-- 3. YOUR BOOKINGS LIST -->
        <!-- ========================================================================= -->
        <section class="space-y-3" id="bookings-section">
            <!-- Section Heading Row -->
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <h2 class="text-base font-bold text-primary font-mono lang-text"
                        data-en="{{ labels_en.profile_bookings_title }}"
                        data-hi="{{ labels_hi.profile_bookings_title }}">{{ labels.profile_bookings_title }}</h2>
                    <span class="text-xs font-mono bg-surface-container text-on-surface-variant px-2.5 py-0.5 rounded-full font-bold"
                          id="booking-count-badge">0</span>
                </div>
                <button type="button"
                        onclick="toggleEmptyState()"
                        id="toggle-empty-state-btn"
                        data-sim-text="{{ labels.profile_simulate_empty }}"
                        data-restore-text="{{ labels.profile_restore_list }}"
                        class="text-xs font-medium text-on-surface-variant hover:text-primary transition-colors underline cursor-pointer">
                    <span class="lang-text"
                          data-en="{{ labels_en.profile_restore_list }}"
                          data-hi="{{ labels_hi.profile_restore_list }}">{{ labels.profile_restore_list }}</span>
                </button>
            </div>
            <!-- Filter Chips Row -->
            {% call filter_chips(id="booking-filters", on_change="setFilter", variant="pills", size="md") %}
                {{ filter_chip(id="filter-all", value="all", label=labels.profile_filter_all, label_en=labels_en.profile_filter_all, label_hi=labels_hi.profile_filter_all, is_active=true) }}
                {{ filter_chip(id="filter-active", value="active", label=labels.profile_filter_active, label_en=labels_en.profile_filter_active, label_hi=labels_hi.profile_filter_active) }}
                {{ filter_chip(id="filter-completed", value="completed", label=labels.profile_filter_completed, label_en=labels_en.profile_filter_completed, label_hi=labels_hi.profile_filter_completed) }}
            {% endcall %}
            <!-- Booking Cards Container with Default Empty State -->
            {{ booking_cards_container(id="booking-cards-container", active_state="empty") }}
        </section>
        <!-- ========================================================================= -->
        <!-- 4. SUPPORT & SIGN-OUT -->
        <!-- ========================================================================= -->
        <section class="space-y-3 pt-2">
            <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 divide-y divide-primary/5 overflow-hidden shadow-sm">
                <!-- Row 1: Concierge Phone -->
                <a class="flex items-center justify-between p-4 hover:bg-surface-container-low transition-colors group"
                   href="tel:18004197688">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors">
                            {{ icon("support_agent", size=18) }}
                        </div>
                        <span class="text-xs text-primary font-medium">
                            <span class="lang-text"
                                  data-en="{{ labels_en.profile_call_concierge }}"
                                  data-hi="{{ labels_hi.profile_call_concierge }}">
                                {{ labels.profile_call_concierge }}
                            </span>
                            <strong class="font-mono text-primary font-bold">1800-419-7688</strong>
                        </span>
                    </div>
                    <span class="text-outline flex items-center group-hover:translate-x-0.5 transition-transform">{{ icon("chevron_right", size=18) }}</span>
                </a>
                <!-- Row 2: WhatsApp Desk -->
                <a class="flex items-center justify-between p-4 hover:bg-surface-container-low transition-colors group"
                   href="https://wa.me/919820144829"
                   rel="noopener noreferrer"
                   target="_blank">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors">
                            {{ icon("chat", size=18) }}
                        </div>
                        <span class="text-xs text-primary font-medium lang-text"
                              data-en="{{ labels_en.profile_whatsapp_desk }}"
                              data-hi="{{ labels_hi.profile_whatsapp_desk }}">{{ labels.profile_whatsapp_desk }}</span>
                    </div>
                    <span class="text-outline flex items-center group-hover:translate-x-0.5 transition-transform">{{ icon("chevron_right", size=18) }}</span>
                </a>
                <!-- Row 3: Sign Out Action -->
                <div class="p-4 flex items-center justify-between bg-surface-container-lowest">
                    <button type="button"
                            onclick="confirmSignOut()"
                            class="text-secondary font-bold text-xs hover:underline cursor-pointer flex items-center gap-1.5">
                        {{ icon("logout", size=18) }}
                        <span class="lang-text"
                              data-en="{{ labels_en.profile_sign_out }}"
                              data-hi="{{ labels_hi.profile_sign_out }}">{{ labels.profile_sign_out }}</span>
                    </button>
                    <span class="text-[11px] text-on-surface-variant font-mono">v1.8.4</span>
                </div>
            </div>
            <!-- Subtle POC Notice -->
            <p class="text-[11px] text-on-surface-variant text-center px-4 leading-relaxed lang-text"
               data-en="{{ labels_en.profile_legal_notice }}"
               data-hi="{{ labels_hi.profile_legal_notice }}">{{ labels.profile_legal_notice }}</p>
        </section>
    </div>
    <!-- Sign Out Confirmation Modal Dialog -->
    {% call modal(id="signout-confirm-modal", title=labels.profile_sign_out, icon_name="logout", icon_classes="text-warning") %}
        <p class="text-xs text-on-surface-variant mb-4">
            <span class="lang-text"
                  data-en="{{ labels_en.profile_sign_out_confirm|default('Are you sure you want to sign out of LoadShare?') }}"
                  data-hi="{{ labels_hi.profile_sign_out_confirm|default('क्या आप वाकई लोडशेयर से साइन आउट करना चाहते हैं?') }}">
                {{ labels.profile_sign_out_confirm|default("Are you sure you want to sign out of LoadShare?") }}
            </span>
        </p>
        <div class="ls-modal-actions">
            <button type="button"
                    class="ls-modal-btn ls-modal-btn--ghost"
                    onclick="if (window.LoadShareModal) { LoadShareModal.close('signout-confirm-modal'); } else { document.getElementById('signout-confirm-modal').style.display='none'; }">
                <span class="lang-text" data-en="Cancel" data-hi="रद्द करें">Cancel</span>
            </button>
            <button type="button"
                    class="ls-modal-btn ls-modal-btn--danger"
                    onclick="executeSignOut()">
                {{ icon("logout", size=16) }}
                <span class="lang-text"
                      data-en="{{ labels_en.profile_sign_out }}"
                      data-hi="{{ labels_hi.profile_sign_out }}">{{ labels.profile_sign_out }}</span>
            </button>
        </div>
    {% endcall %}
    <!-- Self-contained Sign Out Controller Script -->
    <script>
        (function() {
            if (!window.executeSignOut) {
                window.executeSignOut = function() {
                    var cookieNames = [
                        "access_token",
                        "refresh_token",
                        "loadshare_jwt",
                        "customer_id",
                        "sessionid",
                        "jwt_auth_synced"
                    ];
                    for (var i = 0; i < cookieNames.length; i++) {
                        var name = cookieNames[i];
                        document.cookie = name + "=; path=/; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT";
                        document.cookie = name + "=; path=/; domain=" + window.location.hostname + "; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT";
                    }
                    try {
                        if (window.sessionStorage) {
                            sessionStorage.removeItem("customer_id");
                            sessionStorage.removeItem("customer_data");
                            sessionStorage.removeItem("jwt_auth_synced");
                            sessionStorage.clear();
                        }
                        if (window.localStorage) {
                            localStorage.removeItem("customer_id");
                            localStorage.removeItem("customer_data");
                        }
                    } catch (e) {
                        console.debug("Sign out storage clear error:", e);
                    }
                    window.location.href = "/logout/";
                };
            }

            if (!window.confirmSignOut) {
                window.confirmSignOut = function() {
                    if (window.LoadShareModal && document.getElementById("signout-confirm-modal")) {
                        window.LoadShareModal.open("signout-confirm-modal");
                    } else {
                        var isHi = (window.getActiveLanguage && window.getActiveLanguage() === "hi");
                        var msg = isHi ?
                            "क्या आप वाकई लोडशेयर से साइन आउट करना चाहते हैं?" :
                            "Are you sure you want to sign out of LoadShare?";
                        if (window.confirm(msg)) {
                            window.executeSignOut();
                        }
                    }
                };
            }

            if (window.LoadShareProfile) {
                window.LoadShareProfile.confirmSignOut = window.confirmSignOut;
                window.LoadShareProfile.executeSignOut = window.executeSignOut;
            }
        })();
    </script>
</section>
