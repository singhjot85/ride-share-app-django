{# Dedicated NH48 Delhi ⇄ Jaipur Corridor Search & Linehaul Booking View #}
{% from "core/components/common/icons.jinja" import icon %}
{% from "components/carousel.jinja" import carousel, carousel_slide %}
{% from "components/state_card.jinja" import state_container, state_panel %}
{% from "components/filter_chips.jinja" import filter_chips, filter_chip %}
<section id="view-book-corridor"
         class="landing-tab-view hidden"
         aria-labelledby="corridor-view-title">
    <div class="landing-view-container max-w-2xl mx-auto px-4 md:px-8 py-5 space-y-6">
        <!-- ========================================================================= -->
        <!-- 1. CORRIDOR CONTEXT BAR (Breadcrumb + route facts + timing badge) -->
        <!-- ========================================================================= -->
        <div class="bg-surface-container-low border border-outline-variant/50 rounded-xl px-4 py-2.5 shadow-xs">
            <div class="flex flex-wrap items-center justify-between text-xs font-mono text-on-surface-variant gap-2">
                <div class="flex items-center gap-2 flex-wrap">
                    <button type="button"
                            onclick="LoadShareNav.switchTab('home')"
                            class="btn-back-link hover:text-primary transition-colors">
                        {{ icon("arrow_back", size=14) }}
                        <span class="lang-text"
                              data-en="{{ labels_en.corridor_back_home }}"
                              data-hi="{{ labels_hi.corridor_back_home }}">{{ labels.corridor_back_home }}</span>
                    </button>
                    <span class="text-outline-variant">•</span>
                    <span class="font-medium text-primary lang-text"
                          data-en="{{ labels_en.corridor_route_facts }}"
                          data-hi="{{ labels_hi.corridor_route_facts }}">{{ labels.corridor_route_facts }}</span>
                </div>
                <div class="inline-flex items-center gap-1.5 bg-surface-container px-2 py-0.5 rounded text-[11px] font-semibold text-secondary">
                    {{ icon("schedule", size=12) }}
                    <span class="lang-text"
                          data-en="{{ labels_en.corridor_timing_badge }}"
                          data-hi="{{ labels_hi.corridor_timing_badge }}">{{ labels.corridor_timing_badge }}</span>
                </div>
            </div>
        </div>
        <!-- ========================================================================= -->
        <!-- 2. REVIEWER PREVIEW TOOLBAR (Interactive State Switcher) -->
        <!-- ========================================================================= -->
        <div class="bg-surface-container-high/60 border border-outline-variant/40 rounded-xl px-4 py-2.5">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
                <div class="flex items-center gap-1.5 font-mono text-on-surface-variant">
                    {{ icon("science", size=16) }}
                    <span class="font-bold lang-text"
                          data-en="{{ labels_en.reviewer_state_label }}"
                          data-hi="{{ labels_hi.reviewer_state_label }}">{{ labels.reviewer_state_label }}</span>
                </div>
                {% call filter_chips(id="reviewer-state-switcher", on_change="setCorridorState", variant="segmented", size="sm") %}
                    {{ filter_chip(id="btnStateDefault", value="default", label=labels.btn_state_trucks, label_en=labels_en.btn_state_trucks, label_hi=labels_hi.btn_state_trucks, is_active=true) }}
                    {{ filter_chip(id="btnStateSkeleton", value="skeleton", label=labels.btn_state_skeleton, label_en=labels_en.btn_state_skeleton, label_hi=labels_hi.btn_state_skeleton) }}
                    {{ filter_chip(id="btnStateEmpty", value="empty", label=labels.btn_state_empty_corridor, label_en=labels_en.btn_state_empty_corridor, label_hi=labels_hi.btn_state_empty_corridor) }}
                    {{ filter_chip(id="btnStateCapacity", value="capacity", label=labels.btn_state_capacity, label_en=labels_en.btn_state_capacity, label_hi=labels_hi.btn_state_capacity) }}
                    {{ filter_chip(id="btnStateError", value="error", label=labels.btn_state_error, label_en=labels_en.btn_state_error, label_hi=labels_hi.btn_state_error) }}
                {% endcall %}
            </div>
        </div>
        <!-- ========================================================================= -->
        <!-- 3. SEARCH BLOCK (3-STEP PROGRESSIVE WIZARD CAROUSEL) -->
        <!-- ========================================================================= -->
        {% call carousel(
            id="search-engine",
            title=labels.wizard_title,
            title_icon="search",
            total_steps=3,
            initial_step=1,
            variant="wizard",
            title_en=labels_en.wizard_title,
            title_hi=labels_hi.wizard_title
            ) %}
            <!-- STEP 1: PICKUP & DROP HUB SELECTION -->
            {% call carousel_slide(id="wizardStep1", step_number=1, is_active=true) %}
                <div class="space-y-3">
                    <!-- Pickup Hub Selection -->
                    <div class="bg-surface-container-low/70 rounded-xl p-3 md:p-4 border border-outline-variant/40 space-y-2.5">
                        <div class="flex items-center justify-between">
                            <label class="text-[11px] font-mono font-bold uppercase tracking-wider text-on-surface-variant flex items-center gap-1">
                                <span class="text-secondary flex items-center">{{ icon("trip_origin", size=14) }}</span>
                                <span class="lang-text"
                                      data-en="{{ labels_en.label_pickup_point }}"
                                      data-hi="{{ labels_hi.label_pickup_point }}">
                                    {{ labels.label_pickup_point }}
                                </span>
                            </label>
                            <span class="text-[10px] font-mono text-secondary font-semibold lang-text"
                                  data-en="{{ labels_en.corridor_name_tag }}"
                                  data-hi="{{ labels_hi.corridor_name_tag }}">{{ labels.corridor_name_tag }}</span>
                        </div>
                        <button type="button"
                                onclick="simulateLocationClick(this)"
                                class="w-full bg-surface-container-lowest hover:bg-surface-container border border-outline-variant/80 rounded-lg p-3 text-left flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs font-semibold text-primary transition-colors">
                            <span class="flex items-center gap-2">
                                <span class="text-secondary flex items-center shrink-0">{{ icon("my_location", size=18) }}</span>
                                <span class="leading-snug">
                                    <span class="block lang-text"
                                          data-en="{{ labels_en.btn_use_location }}"
                                          data-hi="{{ labels_hi.btn_use_location }}">
                                        {{ labels.btn_use_location }}
                                    </span>
                                    <span class="block text-[11px] text-on-surface-variant font-normal lang-text"
                                          data-en="{{ labels_en.pickup_detected_hint }}"
                                          data-hi="{{ labels_hi.pickup_detected_hint }}">
                                        {{ labels.pickup_detected_hint }}
                                    </span>
                                </span>
                            </span>
                            <span class="text-[11px] font-mono text-secondary self-start sm:self-center shrink-0">0.8 km</span>
                        </button>
                        <!-- Quick Hub Selector Pills -->
                        <div class="flex items-center gap-1.5 flex-wrap pt-1 text-[11px] font-mono">
                            <span class="text-on-surface-variant mr-1 lang-text"
                                  data-en="{{ labels_en.quick_hubs_label }}"
                                  data-hi="{{ labels_hi.quick_hubs_label }}">{{ labels.quick_hubs_label }}</span>
                            <button type="button"
                                    onclick="quickSelectPickup('Delhi (SGTN Bay 4)', this)"
                                    class="quick-hub-btn">
                                <span class="lang-text"
                                      data-en="{{ labels_en.hub_sgtn }}"
                                      data-hi="{{ labels_hi.hub_sgtn }}">{{ labels.hub_sgtn }}</span>
                            </button>
                            <button type="button"
                                    onclick="quickSelectPickup('Gurugram (Hero Honda)', this)"
                                    class="quick-hub-btn">
                                <span class="lang-text"
                                      data-en="{{ labels_en.hub_gurugram }}"
                                      data-hi="{{ labels_hi.hub_gurugram }}">{{ labels.hub_gurugram }}</span>
                            </button>
                            <button type="button"
                                    onclick="quickSelectPickup('Manesar IMT Depot', this)"
                                    class="quick-hub-btn">
                                <span class="lang-text"
                                      data-en="{{ labels_en.hub_manesar }}"
                                      data-hi="{{ labels_hi.hub_manesar }}">{{ labels.hub_manesar }}</span>
                            </button>
                        </div>
                    </div>
                    <!-- Drop Hub Selection -->
                    <div class="bg-surface-container-low/70 rounded-xl p-3 md:p-4 border border-outline-variant/40 space-y-2.5">
                        <label class="text-[11px] font-mono font-bold uppercase tracking-wider text-on-surface-variant flex items-center gap-1">
                            <span class="text-primary flex items-center">{{ icon("location_on", size=14) }}</span>
                            <span class="lang-text"
                                  data-en="{{ labels_en.label_drop_destination }}"
                                  data-hi="{{ labels_hi.label_drop_destination }}">
                                {{ labels.label_drop_destination }}
                            </span>
                        </label>
                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5 bg-surface-container-lowest border border-outline-variant/80 rounded-lg p-3">
                            <div class="flex items-start gap-2.5">
                                <span class="text-primary flex items-center mt-0.5 shrink-0">{{ icon("domain", size=20) }}</span>
                                <div>
                                    <span class="text-xs font-bold text-primary font-mono block"
                                          id="displayDropHub">{{ labels.drop_default_hub }}</span>
                                    <span class="text-[11px] text-on-surface-variant block leading-normal lang-text"
                                          data-en="{{ labels_en.drop_default_address }}"
                                          data-hi="{{ labels_hi.drop_default_address }}">
                                        {{ labels.drop_default_address }}
                                    </span>
                                </div>
                            </div>
                            <div class="sm:text-right shrink-0 border-t sm:border-t-0 pt-2 sm:pt-0 border-outline-variant/30">
                                <select class="bg-surface-container sm:bg-transparent border border-outline-variant/40 sm:border-0 rounded sm:rounded-none px-2 py-1 sm:p-0 text-secondary text-xs font-mono font-bold focus:ring-0 cursor-pointer w-full sm:w-auto text-left sm:text-right"
                                        id="dropHubSelect"
                                        onchange="updateDropHub(this.value)">
                                    <option selected>Jaipur VKI Depot</option>
                                    <option>Kotputli Node (Drop)</option>
                                    <option>Delhi Depot (Return)</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Step 1 Nav CTA -->
                <button type="button"
                        onclick="goToWizardStep(2)"
                        class="w-full bg-secondary hover:bg-secondary-container active:scale-[0.99] text-on-secondary py-3 px-4 rounded-xl text-sm font-bold tracking-wide transition-all shadow-md flex items-center justify-center gap-2">
                    <span class="lang-text"
                          data-en="{{ labels_en.btn_next_window }}"
                          data-hi="{{ labels_hi.btn_next_window }}">{{ labels.btn_next_window }}</span>
                    {{ icon("arrow_forward", size=16) }}
                </button>
            {% endcall %}
            <!-- STEP 2: DEPARTURE WINDOW -->
            {% call carousel_slide(id="wizardStep2", step_number=2, is_active=false) %}
                <div class="bg-surface-container-low/70 rounded-xl p-3 md:p-4 border border-outline-variant/40 space-y-3">
                    <div class="flex items-center justify-between">
                        <label class="text-[11px] font-mono font-bold uppercase tracking-wider text-on-surface-variant flex items-center gap-1">
                            <span class="text-primary flex items-center">{{ icon("schedule", size=14) }}</span>
                            <span class="lang-text"
                                  data-en="{{ labels_en.label_departure_window }}"
                                  data-hi="{{ labels_hi.label_departure_window }}">
                                {{ labels.label_departure_window }}
                            </span>
                        </label>
                        <span class="text-[10px] font-mono text-on-surface-variant lang-text"
                              data-en="{{ labels_en.tonight_priority_badge }}"
                              data-hi="{{ labels_hi.tonight_priority_badge }}">
                            {{ labels.tonight_priority_badge }}
                        </span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 font-mono text-xs">
                        <button type="button"
                                onclick="selectDateWindow(this)"
                                class="date-pill active py-2.5 px-3 text-left sm:text-center font-bold rounded-lg border transition-all bg-primary text-on-primary border-primary shadow-xs flex flex-row sm:flex-col justify-between sm:justify-center items-center">
                            <span class="text-xs leading-tight">
                                <span class="block lang-text"
                                      data-en="{{ labels_en.window_tonight }}"
                                      data-hi="{{ labels_hi.window_tonight }}">{{ labels.window_tonight }}</span>
                            </span>
                            <span class="text-[11px] opacity-80 font-normal">{{ labels.window_tonight_sub }}</span>
                        </button>
                        <button type="button"
                                onclick="selectDateWindow(this)"
                                class="date-pill py-2.5 px-3 text-left sm:text-center font-semibold rounded-lg border border-outline-variant bg-surface-container-lowest text-primary hover:bg-surface-container transition-all flex flex-row sm:flex-col justify-between sm:justify-center items-center">
                            <span class="text-xs leading-tight">
                                <span class="block lang-text"
                                      data-en="{{ labels_en.window_tomorrow }}"
                                      data-hi="{{ labels_hi.window_tomorrow }}">{{ labels.window_tomorrow }}</span>
                            </span>
                            <span class="text-[11px] text-on-surface-variant font-normal">{{ labels.window_tomorrow_sub }}</span>
                        </button>
                        <button type="button"
                                onclick="selectDateWindow(this)"
                                class="date-pill py-2.5 px-3 text-left sm:text-center font-semibold rounded-lg border border-outline-variant bg-surface-container-lowest text-primary hover:bg-surface-container transition-all flex flex-row sm:flex-col justify-between sm:justify-center items-center">
                            <span class="text-xs leading-tight">
                                <span class="block lang-text"
                                      data-en="{{ labels_en.window_custom }}"
                                      data-hi="{{ labels_hi.window_custom }}">{{ labels.window_custom }}</span>
                            </span>
                            <span class="text-[11px] text-on-surface-variant font-normal">{{ labels.window_custom_sub }}</span>
                        </button>
                    </div>
                </div>
                <!-- Step 2 Nav CTA Buttons -->
                <div class="flex items-center gap-3">
                    <button type="button"
                            onclick="goToWizardStep(1)"
                            class="w-1/3 bg-surface-container hover:bg-surface-container-high text-primary py-3 px-3 rounded-xl text-xs font-mono font-bold transition-all flex items-center justify-center gap-1.5">
                        {{ icon("arrow_back", size=14) }}
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_wizard_back }}"
                              data-hi="{{ labels_hi.btn_wizard_back }}">{{ labels.btn_wizard_back }}</span>
                    </button>
                    <button type="button"
                            onclick="goToWizardStep(3)"
                            class="w-2/3 bg-secondary hover:bg-secondary-container active:scale-[0.99] text-on-secondary py-3 px-4 rounded-xl text-sm font-bold tracking-wide transition-all shadow-md flex items-center justify-center gap-2">
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_next_weight }}"
                              data-hi="{{ labels_hi.btn_next_weight }}">{{ labels.btn_next_weight }}</span>
                        {{ icon("arrow_forward", size=16) }}
                    </button>
                </div>
            {% endcall %}
            <!-- STEP 3: CONSIGNMENT WEIGHT & SEARCH ACTION -->
            {% call carousel_slide(id="wizardStep3", step_number=3, is_active=false) %}
                <div class="bg-surface-container-low/70 rounded-xl p-3 md:p-4 border border-outline-variant/40 space-y-3">
                    <div class="flex items-center justify-between">
                        <label class="text-[11px] font-mono font-bold uppercase tracking-wider text-on-surface-variant flex items-center gap-1">
                            <span class="text-primary flex items-center">{{ icon("scale", size=14) }}</span>
                            <span class="lang-text"
                                  data-en="{{ labels_en.label_consignment_weight }}"
                                  data-hi="{{ labels_hi.label_consignment_weight }}">
                                {{ labels.label_consignment_weight }}
                            </span>
                        </label>
                        <span class="text-[10px] font-mono text-secondary font-bold lang-text"
                              data-en="{{ labels_en.fair_tariff_badge }}"
                              data-hi="{{ labels_hi.fair_tariff_badge }}">{{ labels.fair_tariff_badge }}</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 font-mono text-xs">
                        <button type="button"
                                onclick="selectWeightSlab('sm', this)"
                                class="weight-pill active py-2.5 px-2 text-center rounded-lg border border-secondary bg-secondary-fixed text-on-secondary-fixed font-bold shadow-xs transition-all">
                            <span class="font-bold text-xs block">{{ labels.weight_slab_sm_title }}</span>
                            <span class="text-[11px] text-on-surface-variant lang-text"
                                  data-en="{{ labels_en.weight_slab_sm_desc }}"
                                  data-hi="{{ labels_hi.weight_slab_sm_desc }}">{{ labels.weight_slab_sm_desc }}</span>
                        </button>
                        <button type="button"
                                onclick="selectWeightSlab('md', this)"
                                class="weight-pill py-2.5 px-2 text-center rounded-lg border border-outline-variant bg-surface-container-lowest text-primary hover:bg-surface-container font-semibold transition-all">
                            <span class="font-bold text-xs block">{{ labels.weight_slab_md_title }}</span>
                            <span class="text-[11px] text-secondary lang-text"
                                  data-en="{{ labels_en.weight_slab_md_desc }}"
                                  data-hi="{{ labels_hi.weight_slab_md_desc }}">{{ labels.weight_slab_md_desc }}</span>
                        </button>
                        <button type="button"
                                onclick="selectWeightSlab('lg', this)"
                                class="weight-pill py-2.5 px-2 text-center rounded-lg border border-outline-variant bg-surface-container-lowest text-primary hover:bg-surface-container font-semibold transition-all">
                            <span class="font-bold text-xs block">{{ labels.weight_slab_lg_title }}</span>
                            <span class="text-[11px] text-on-surface-variant lang-text"
                                  data-en="{{ labels_en.weight_slab_lg_desc }}"
                                  data-hi="{{ labels_hi.weight_slab_lg_desc }}">{{ labels.weight_slab_lg_desc }}</span>
                        </button>
                    </div>
                </div>
                <!-- Back + Find Trucks CTA -->
                <div class="flex items-center gap-3">
                    <button type="button"
                            onclick="goToWizardStep(2)"
                            class="w-1/4 bg-surface-container hover:bg-surface-container-high text-primary py-3.5 px-3 rounded-xl text-xs font-mono font-bold transition-all flex items-center justify-center gap-1">
                        {{ icon("arrow_back", size=14) }}
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_wizard_back }}"
                              data-hi="{{ labels_hi.btn_wizard_back }}">{{ labels.btn_wizard_back }}</span>
                    </button>
                    <button type="button"
                            onclick="triggerSearch()"
                            class="w-3/4 bg-secondary hover:bg-secondary-container active:scale-[0.99] text-on-secondary py-3.5 px-4 rounded-xl text-sm font-bold tracking-wide transition-all shadow-md flex items-center justify-center gap-2">
                        {{ icon("local_shipping", size=18) }}
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_find_corridor_trucks }}"
                              data-hi="{{ labels_hi.btn_find_corridor_trucks }}">
                            {{ labels.btn_find_corridor_trucks }}
                        </span>
                    </button>
                </div>
            {% endcall %}
        {% endcall %}
        <!-- ========================================================================= -->
        <!-- 4. RESULTS SECTION (LINEHAUL TRUCKS DISPATCH ENGINE) -->
        <!-- ========================================================================= -->
        {% call state_container(id="results-container", active_state="default", extra_classes="space-y-3") %}
            <!-- Results Header -->
            <div class="flex items-center justify-between px-1" id="resultsHeader">
                <div class="flex items-center gap-2">
                    <span class="live-dot-pulse"></span>
                    <h2 class="text-sm font-bold text-primary font-mono lang-text"
                        data-en="{{ labels_en.results_count_live }}"
                        data-hi="{{ labels_hi.results_count_live }}">{{ labels.results_count_live }}</h2>
                </div>
            </div>
            <!-- STATE: 3 TRUCK RESULT CARDS (DEFAULT) -->
            {% call state_panel(id="stateCardsDefault", state="default", is_active=true, extra_classes="space-y-3") %}
                <!-- Result Card 1 -->
                <article class="truck-card bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-4 md:p-5 shadow-sm space-y-3.5">
                    <div class="flex items-center justify-between w-full">
                        <span class="text-2xl font-bold font-mono text-primary tracking-tight">19:30</span>
                        <span class="w-7 h-7 rounded-full badge-verified flex items-center justify-center shrink-0 shadow-xs"
                              title="{{ labels.verified_carrier_tooltip }}">{{ icon("check", size=16) }}</span>
                    </div>
                    <!-- Price line -->
                    <div class="flex items-center gap-2 -mt-1 font-mono text-xs">
                        <span class="font-bold text-sm text-primary">₹850</span>
                        <span class="text-on-surface-variant text-[11px] lang-text"
                              data-en="{{ labels_en.total_price_suffix }}"
                              data-hi="{{ labels_hi.total_price_suffix }}">{{ labels.total_price_suffix }}</span>
                        <span class="text-outline-variant">•</span>
                        <span class="text-secondary font-semibold">₹8.50 / kg</span>
                    </div>
                    <!-- Route segment -->
                    <div class="bg-surface-container-low/70 rounded-xl p-3 flex flex-col sm:flex-row sm:items-center justify-between text-xs font-mono border border-outline-variant/30 gap-2">
                        <div class="flex items-center gap-2">
                            <span class="text-success font-bold shrink-0">●</span>
                            <span class="text-primary font-medium leading-normal">Sanjay Gandhi Transport Nagar</span>
                        </div>
                        <div class="flex items-center gap-2 sm:self-center">
                            <span class="hidden sm:inline-block text-outline">{{ icon("arrow_forward", size=14) }}</span>
                            <span class="sm:hidden text-outline">{{ icon("arrow_downward", size=14) }}</span>
                        </div>
                        <div class="flex items-center gap-2 sm:justify-end">
                            <span class="text-danger font-bold shrink-0">●</span>
                            <span class="text-primary font-medium leading-normal">Jaipur VKI Depot</span>
                        </div>
                    </div>
                    <!-- Spec & Action CTA -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1 border-t border-outline-variant/30">
                        <div class="flex items-center justify-between w-full text-xs font-mono py-0.5">
                            <span class="text-primary font-medium">Eicher Pro 14ft</span>
                            <span class="text-success font-bold">
                                320 kg <span class="lang-text"
       data-en="{{ labels_en.available_suffix }}"
       data-hi="{{ labels_hi.available_suffix }}">{{ labels.available_suffix }}</span>
                            </span>
                        </div>
                        <button type="button"
                                onclick="selectTruck('19:30', 'Eicher Pro 14ft', '₹850', this)"
                                class="select-truck-btn bg-surface-container hover:bg-secondary hover:text-on-secondary text-primary px-3.5 py-1.5 rounded-lg text-xs font-bold font-mono transition-all">
                            <span class="lang-text"
                                  data-en="{{ labels_en.btn_request_reserve }}"
                                  data-hi="{{ labels_hi.btn_request_reserve }}">{{ labels.btn_request_reserve }}</span>
                        </button>
                    </div>
                </article>
                <!-- Result Card 2 -->
                <article class="truck-card bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-4 md:p-5 shadow-sm space-y-3.5">
                    <div class="flex items-center justify-between w-full">
                        <span class="text-2xl font-bold font-mono text-primary tracking-tight">20:45</span>
                        <span class="w-7 h-7 rounded-full badge-verified flex items-center justify-center shrink-0 shadow-xs"
                              title="{{ labels.verified_carrier_tooltip }}">{{ icon("check", size=16) }}</span>
                    </div>
                    <div class="flex items-center gap-2 -mt-1 font-mono text-xs">
                        <span class="font-bold text-sm text-primary">₹2,125</span>
                        <span class="text-on-surface-variant text-[11px] lang-text"
                              data-en="{{ labels_en.total_price_suffix }}"
                              data-hi="{{ labels_hi.total_price_suffix }}">{{ labels.total_price_suffix }}</span>
                        <span class="text-outline-variant">•</span>
                        <span class="text-secondary font-semibold">₹8.50 / kg</span>
                    </div>
                    <div class="bg-surface-container-low/70 rounded-xl p-3 flex flex-col sm:flex-row sm:items-center justify-between text-xs font-mono border border-outline-variant/30 gap-2">
                        <div class="flex items-center gap-2">
                            <span class="text-success font-bold shrink-0">●</span>
                            <span class="text-primary font-medium leading-normal">Gurugram Hero Honda Chowk</span>
                        </div>
                        <div class="flex items-center gap-2 sm:self-center">
                            <span class="hidden sm:inline-block text-outline">{{ icon("arrow_forward", size=14) }}</span>
                            <span class="sm:hidden text-outline">{{ icon("arrow_downward", size=14) }}</span>
                        </div>
                        <div class="flex items-center gap-2 sm:justify-end">
                            <span class="text-danger font-bold shrink-0">●</span>
                            <span class="text-primary font-medium leading-normal">Jaipur VKI Depot</span>
                        </div>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1 border-t border-outline-variant/30">
                        <div class="flex items-center justify-between w-full text-xs font-mono py-0.5">
                            <span class="text-primary font-medium">Eicher Pro 17ft</span>
                            <span class="text-success font-bold">
                                450 kg <span class="lang-text"
       data-en="{{ labels_en.available_suffix }}"
       data-hi="{{ labels_hi.available_suffix }}">{{ labels.available_suffix }}</span>
                            </span>
                        </div>
                        <button type="button"
                                onclick="selectTruck('20:45', 'Eicher Pro 17ft', '₹2,125', this)"
                                class="select-truck-btn bg-surface-container hover:bg-secondary hover:text-on-secondary text-primary px-3.5 py-1.5 rounded-lg text-xs font-bold font-mono transition-all">
                            <span class="lang-text"
                                  data-en="{{ labels_en.btn_request_reserve }}"
                                  data-hi="{{ labels_hi.btn_request_reserve }}">{{ labels.btn_request_reserve }}</span>
                        </button>
                    </div>
                </article>
                <!-- Result Card 3 -->
                <article class="truck-card bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-4 md:p-5 shadow-sm space-y-3.5">
                    <div class="flex items-center justify-between w-full">
                        <span class="text-2xl font-bold font-mono text-primary tracking-tight">21:40</span>
                        <span class="w-7 h-7 rounded-full badge-verified flex items-center justify-center shrink-0 shadow-xs"
                              title="{{ labels.verified_carrier_tooltip }}">{{ icon("check", size=16) }}</span>
                    </div>
                    <div class="flex items-center gap-2 -mt-1 font-mono text-xs">
                        <span class="font-bold text-sm text-primary">₹1,275</span>
                        <span class="text-on-surface-variant text-[11px] lang-text"
                              data-en="{{ labels_en.total_price_suffix }}"
                              data-hi="{{ labels_hi.total_price_suffix }}">{{ labels.total_price_suffix }}</span>
                        <span class="text-outline-variant">•</span>
                        <span class="text-secondary font-semibold">₹8.50 / kg</span>
                    </div>
                    <div class="bg-surface-container-low/70 rounded-xl p-3 flex flex-col sm:flex-row sm:items-center justify-between text-xs font-mono border border-outline-variant/30 gap-2">
                        <div class="flex items-center gap-2">
                            <span class="text-success font-bold shrink-0">●</span>
                            <span class="text-primary font-medium leading-normal">Manesar IMT Toll Plaza</span>
                        </div>
                        <div class="flex items-center gap-2 sm:self-center">
                            <span class="hidden sm:inline-block text-outline">{{ icon("arrow_forward", size=14) }}</span>
                            <span class="sm:hidden text-outline">{{ icon("arrow_downward", size=14) }}</span>
                        </div>
                        <div class="flex items-center gap-2 sm:justify-end">
                            <span class="text-danger font-bold shrink-0">●</span>
                            <span class="text-primary font-medium leading-normal">Kotputli Junction</span>
                        </div>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1 border-t border-outline-variant/30">
                        <div class="flex items-center justify-between w-full text-xs font-mono py-0.5">
                            <span class="text-primary font-medium">Tata 407</span>
                            <span class="text-success font-bold">
                                180 kg <span class="lang-text"
       data-en="{{ labels_en.available_suffix }}"
       data-hi="{{ labels_hi.available_suffix }}">{{ labels.available_suffix }}</span>
                            </span>
                        </div>
                        <button type="button"
                                onclick="selectTruck('21:40', 'Tata 407', '₹1,275', this)"
                                class="select-truck-btn bg-surface-container hover:bg-secondary hover:text-on-secondary text-primary px-3.5 py-1.5 rounded-lg text-xs font-bold font-mono transition-all">
                            <span class="lang-text"
                                  data-en="{{ labels_en.btn_request_reserve }}"
                                  data-hi="{{ labels_hi.btn_request_reserve }}">{{ labels.btn_request_reserve }}</span>
                        </button>
                    </div>
                </article>
            {% endcall %}
            <!-- STATE: LOADING SKELETON -->
            {% call state_panel(id="stateCardsSkeleton", state="skeleton", is_active=false, extra_classes="space-y-3") %}
                <div class="bg-surface-container-lowest border border-outline-variant/40 rounded-2xl p-4 shadow-sm animate-pulse space-y-3">
                    <div class="flex justify-between">
                        <div class="h-6 w-32 bg-surface-container-high rounded"></div>
                        <div class="h-6 w-24 bg-surface-container-high rounded"></div>
                    </div>
                    <div class="h-10 w-full bg-surface-container-low rounded-xl"></div>
                    <div class="flex justify-between pt-1">
                        <div class="h-5 w-40 bg-surface-container-high rounded"></div>
                        <div class="h-7 w-28 bg-surface-container-high rounded-lg"></div>
                    </div>
                </div>
                <div class="bg-surface-container-lowest border border-outline-variant/40 rounded-2xl p-4 shadow-sm animate-pulse space-y-3">
                    <div class="flex justify-between">
                        <div class="h-6 w-32 bg-surface-container-high rounded"></div>
                        <div class="h-6 w-24 bg-surface-container-high rounded"></div>
                    </div>
                    <div class="h-10 w-full bg-surface-container-low rounded-xl"></div>
                    <div class="flex justify-between pt-1">
                        <div class="h-5 w-40 bg-surface-container-high rounded"></div>
                        <div class="h-7 w-28 bg-surface-container-high rounded-lg"></div>
                    </div>
                </div>
            {% endcall %}
            <!-- STATE: 0 RESULTS EMPTY STATE -->
            {% call state_panel(id="stateCardsEmpty", state="empty", is_active=false, extra_classes="bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-6 text-center shadow-sm flex flex-col items-center gap-3") %}
                <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-primary">
                    {{ icon("search_off", size=24) }}
                </div>
                <div>
                    <h3 class="font-bold text-sm text-primary font-mono lang-text"
                        data-en="{{ labels_en.empty_corridor_title }}"
                        data-hi="{{ labels_hi.empty_corridor_title }}">{{ labels.empty_corridor_title }}</h3>
                    <p class="text-xs text-on-surface-variant mt-1 max-w-sm mx-auto lang-text"
                       data-en="{{ labels_en.empty_corridor_desc }}"
                       data-hi="{{ labels_hi.empty_corridor_desc }}">{{ labels.empty_corridor_desc }}</p>
                </div>
                <div class="flex flex-wrap gap-2 justify-center pt-1">
                    <button type="button"
                            onclick="setCorridorState('default')"
                            class="bg-surface-container hover:bg-surface-container-high text-primary px-3.5 py-1.5 rounded-lg text-xs font-mono font-semibold transition-colors">
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_reset_filters }}"
                              data-hi="{{ labels_hi.btn_reset_filters }}">{{ labels.btn_reset_filters }}</span>
                    </button>
                    <button type="button"
                            onclick="window.alert('Standby registered. SMS alert will arrive if capacity opens.')"
                            class="bg-secondary text-on-secondary px-3.5 py-1.5 rounded-lg text-xs font-mono font-bold transition-all shadow-xs">
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_join_standby }}"
                              data-hi="{{ labels_hi.btn_join_standby }}">{{ labels.btn_join_standby }}</span>
                    </button>
                </div>
            {% endcall %}
            <!-- STATE: CORRIDOR AT CAPACITY CARD VARIANT -->
            {% call state_panel(id="stateCardsCapacity", state="capacity", is_active=false, extra_classes="card-capacity-state rounded-2xl p-4 md:p-5 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4") %}
                <div class="flex items-start gap-3">
                    <span class="text-warning flex items-center mt-0.5">{{ icon("warning", size=24) }}</span>
                    <div>
                        <span class="text-[11px] font-mono uppercase bg-warning text-on-warning font-bold px-1.5 py-0.5 rounded lang-text"
                              data-en="{{ labels_en.capacity_badge_text }}"
                              data-hi="{{ labels_hi.capacity_badge_text }}">{{ labels.capacity_badge_text }}</span>
                        <h3 class="font-bold text-sm text-primary font-mono mt-1 lang-text"
                            data-en="{{ labels_en.capacity_corridor_title }}"
                            data-hi="{{ labels_hi.capacity_corridor_title }}">{{ labels.capacity_corridor_title }}</h3>
                        <p class="text-xs text-on-surface-variant mt-0.5 lang-text"
                           data-en="{{ labels_en.capacity_corridor_desc }}"
                           data-hi="{{ labels_hi.capacity_corridor_desc }}">{{ labels.capacity_corridor_desc }}</p>
                    </div>
                </div>
                <button type="button"
                        onclick="window.alert('Standby waitlist confirmed. Next release at 17:30 IST.')"
                        class="w-full sm:w-auto bg-primary hover:bg-primary-hover text-on-primary font-mono text-xs font-bold px-4 py-2 rounded-lg transition-colors whitespace-nowrap shadow-xs">
                    <span class="lang-text"
                          data-en="{{ labels_en.btn_request_standby }}"
                          data-hi="{{ labels_hi.btn_request_standby }}">{{ labels.btn_request_standby }}</span>
                </button>
            {% endcall %}
            <!-- STATE: ERROR STATE -->
            {% call state_panel(id="stateCardsError", state="error", is_active=false, extra_classes="card-error-state rounded-2xl p-5 text-center shadow-sm flex flex-col items-center gap-2") %}
                <span class="text-danger flex items-center">{{ icon("error", size=28) }}</span>
                <h3 class="font-bold text-sm text-primary font-mono lang-text"
                    data-en="{{ labels_en.error_corridor_title }}"
                    data-hi="{{ labels_hi.error_corridor_title }}">{{ labels.error_corridor_title }}</h3>
                <p class="text-xs text-on-surface-variant lang-text"
                   data-en="{{ labels_en.error_corridor_desc }}"
                   data-hi="{{ labels_hi.error_corridor_desc }}">{{ labels.error_corridor_desc }}</p>
                <button type="button"
                        onclick="setCorridorState('default')"
                        class="bg-danger hover:bg-danger/90 text-on-error font-mono text-xs font-bold px-4 py-1.5 rounded-lg mt-1 transition-colors shadow-xs">
                    <span class="lang-text"
                          data-en="{{ labels_en.btn_retry_search }}"
                          data-hi="{{ labels_hi.btn_retry_search }}">{{ labels.btn_retry_search }}</span>
                </button>
            {% endcall %}
        {% endcall %}
        <!-- ========================================================================= -->
        <!-- 5. CORRIDOR DETAILS & ACCORDIONS -->
        <!-- ========================================================================= -->
        <section class="bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-4 md:p-6 shadow-sm space-y-3">
            <div class="border-b border-outline-variant/30 pb-3 mb-1 flex flex-wrap items-center justify-between gap-1">
                <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-secondary lang-text"
                    data-en="{{ labels_en.guidelines_heading }}"
                    data-hi="{{ labels_hi.guidelines_heading }}">{{ labels.guidelines_heading }}</h3>
                <span class="text-[11px] font-mono text-on-surface-variant lang-text"
                      data-en="{{ labels_en.guidelines_count_badge }}"
                      data-hi="{{ labels_hi.guidelines_count_badge }}">{{ labels.guidelines_count_badge }}</span>
            </div>
            <!-- Accordion 1: Pickup points -->
            <details class="group border-b border-outline-variant/30 py-3">
                <summary class="flex justify-between items-center font-bold text-xs md:text-sm text-primary cursor-pointer list-none select-none gap-2">
                    <span class="flex items-center gap-2">
                        <span class="text-secondary flex items-center shrink-0">{{ icon("pin_drop", size=16) }}</span>
                        <span class="leading-snug lang-text"
                              data-en="{{ labels_en.guide_1_q }}"
                              data-hi="{{ labels_hi.guide_1_q }}">{{ labels.guide_1_q }}</span>
                    </span>
                    <span class="text-on-surface-variant shrink-0">{{ icon("expand_more", size=16) }}</span>
                </summary>
                <div class="mt-3 pl-6 text-xs text-on-surface-variant leading-relaxed">
                    <p class="lang-text"
                       data-en="{{ labels_en.guide_1_a }}"
                       data-hi="{{ labels_hi.guide_1_a }}">{{ labels.guide_1_a }}</p>
                </div>
            </details>
            <!-- Accordion 2: Linehaul schedule -->
            <details class="group border-b border-outline-variant/30 py-3">
                <summary class="flex justify-between items-center font-bold text-xs md:text-sm text-primary cursor-pointer list-none select-none gap-2">
                    <span class="flex items-center gap-2">
                        <span class="text-secondary flex items-center shrink-0">{{ icon("timelapse", size=16) }}</span>
                        <span class="leading-snug lang-text"
                              data-en="{{ labels_en.guide_2_q }}"
                              data-hi="{{ labels_hi.guide_2_q }}">{{ labels.guide_2_q }}</span>
                    </span>
                    <span class="text-on-surface-variant shrink-0">{{ icon("expand_more", size=16) }}</span>
                </summary>
                <div class="mt-3 pl-6 text-xs text-on-surface-variant leading-relaxed">
                    <p class="lang-text"
                       data-en="{{ labels_en.guide_2_a }}"
                       data-hi="{{ labels_hi.guide_2_a }}">{{ labels.guide_2_a }}</p>
                </div>
            </details>
            <!-- Accordion 3: Cargo dimensions -->
            <details class="group border-b border-outline-variant/30 py-3">
                <summary class="flex justify-between items-center font-bold text-xs md:text-sm text-primary cursor-pointer list-none select-none gap-2">
                    <span class="flex items-center gap-2">
                        <span class="text-secondary flex items-center shrink-0">{{ icon("inventory_2", size=16) }}</span>
                        <span class="leading-snug lang-text"
                              data-en="{{ labels_en.guide_3_q }}"
                              data-hi="{{ labels_hi.guide_3_q }}">{{ labels.guide_3_q }}</span>
                    </span>
                    <span class="text-on-surface-variant shrink-0">{{ icon("expand_more", size=16) }}</span>
                </summary>
                <div class="mt-3 pl-6 text-xs text-on-surface-variant leading-relaxed">
                    <p class="lang-text"
                       data-en="{{ labels_en.guide_3_a }}"
                       data-hi="{{ labels_hi.guide_3_a }}">{{ labels.guide_3_a }}</p>
                </div>
            </details>
            <!-- Accordion 4: Proof of delivery -->
            <details class="group py-3">
                <summary class="flex justify-between items-center font-bold text-xs md:text-sm text-primary cursor-pointer list-none select-none gap-2">
                    <span class="flex items-center gap-2">
                        <span class="text-secondary flex items-center shrink-0">{{ icon("verified", size=16) }}</span>
                        <span class="leading-snug lang-text"
                              data-en="{{ labels_en.guide_4_q }}"
                              data-hi="{{ labels_hi.guide_4_q }}">{{ labels.guide_4_q }}</span>
                    </span>
                    <span class="text-on-surface-variant shrink-0">{{ icon("expand_more", size=16) }}</span>
                </summary>
                <div class="mt-3 pl-6 text-xs text-on-surface-variant leading-relaxed">
                    <p class="lang-text"
                       data-en="{{ labels_en.guide_4_a }}"
                       data-hi="{{ labels_hi.guide_4_a }}">{{ labels.guide_4_a }}</p>
                </div>
            </details>
        </section>
    </div>
    <!-- ========================================================================= -->
    <!-- 6. PINNED STICKY BOTTOM BAR (Appears on truck selection) -->
    <!-- ========================================================================= -->
    <aside class="sticky-truck-bottom-bar translate-y-full" id="stickyBottomBar">
        <div class="max-w-2xl mx-auto flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
                <div class="p-2 bg-primary-container text-secondary rounded-lg shrink-0 flex items-center justify-center">
                    {{ icon("local_shipping", size=20) }}
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-xs sm:text-sm font-bold font-mono text-on-primary leading-tight"
                         id="pinnedTruckSummary">20:45 departure · Eicher Pro 17ft · ₹2,125</div>
                    <button type="button"
                            onclick="dismissBottomBar()"
                            class="text-[11px] font-mono text-primary-contrast hover:underline inline-flex items-center gap-0.5 mt-0.5 opacity-80 hover:opacity-100">
                        {{ icon("close", size=12) }}
                        <span class="lang-text"
                              data-en="{{ labels_en.pinned_bar_change }}"
                              data-hi="{{ labels_hi.pinned_bar_change }}">{{ labels.pinned_bar_change }}</span>
                    </button>
                </div>
            </div>
            <button type="button"
                    onclick="confirmBooking()"
                    class="w-full sm:w-auto bg-secondary hover:bg-secondary-container text-on-secondary px-5 py-2.5 rounded-xl text-xs sm:text-sm font-mono font-bold tracking-wide transition-all shadow-md shrink-0 flex items-center justify-center gap-2 active:scale-95">
                {{ icon("lock", size=14) }}
                <span class="lang-text"
                      data-en="{{ labels_en.pinned_bar_confirm }}"
                      data-hi="{{ labels_hi.pinned_bar_confirm }}">{{ labels.pinned_bar_confirm }}</span>
            </button>
        </div>
    </aside>
</section>
