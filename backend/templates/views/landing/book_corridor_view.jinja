{# Dedicated NH48 Delhi ⇄ Jaipur Corridor Search & Linehaul Booking View #}
{% from "core/components/common/icons.jinja" import icon %}
<section id="view-book-corridor"
         class="landing-tab-view hidden"
         aria-labelledby="corridor-view-title">
    <div class="landing-view-container max-w-2xl mx-auto px-4 md:px-8 py-5 space-y-6">
        <!-- ========================================================================= -->
        <!-- 1. CORRIDOR CONTEXT BAR (Breadcrumb + route facts + timing badge) -->
        <!-- ========================================================================= -->
        <div class="bg-surface-container-low border border-outline-variant/50 rounded-xl px-4 py-2.5 shadow-xs">
            <div class="flex flex-wrap items-center justify-between text-xs font-mono text-on-surface-variant gap-2">
                <div class="flex items-center gap-2 flex-wrap">
                    <button type="button"
                            onclick="LoadShareNav.switchTab('home')"
                            class="btn-back-link hover:text-primary transition-colors">
                        {{ icon("arrow_back", size=14) }}
                        <span class="lang-text"
                              data-en="{{ labels_en.corridor_back_home|default('Back to Home') }}"
                              data-hi="{{ labels_hi.corridor_back_home|default('होम पर वापस') }}">
                            {{ labels.corridor_back_home|default("Back to Home") }}
                        </span>
                    </button>
                    <span class="text-outline-variant">•</span>
                    <span class="font-medium text-primary lang-text"
                          data-en="{{ labels_en.corridor_route_facts|default('NH48 Corridor · Delhi ⇄ Jaipur · 270 km') }}"
                          data-hi="{{ labels_hi.corridor_route_facts|default('NH48 कॉरिडोर · दिल्ली ⇄ जयपुर · 270 किमी') }}">
                        {{ labels.corridor_route_facts|default("NH48 Corridor · Delhi ⇄ Jaipur · 270 km") }}
                    </span>
                </div>
                <div class="inline-flex items-center gap-1.5 bg-surface-container px-2 py-0.5 rounded text-[11px] font-semibold text-secondary">
                    {{ icon("schedule", size=12) }}
                    <span class="lang-text"
                          data-en="{{ labels_en.corridor_timing_badge|default('Departs daily 18:00–22:00') }}"
                          data-hi="{{ labels_hi.corridor_timing_badge|default('प्रतिदिन रवानगी 18:00–22:00') }}">
                        {{ labels.corridor_timing_badge|default("Departs daily 18:00–22:00") }}
                    </span>
                </div>
            </div>
        </div>
        <!-- ========================================================================= -->
        <!-- 2. REVIEWER PREVIEW TOOLBAR (Interactive State Switcher) -->
        <!-- ========================================================================= -->
        <div class="bg-surface-container-high/60 border border-outline-variant/40 rounded-xl px-4 py-2.5">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
                <div class="flex items-center gap-1.5 font-mono text-on-surface-variant">
                    {{ icon("science", size=16) }}
                    <span class="font-bold lang-text"
                          data-en="{{ labels_en.reviewer_state_label|default('Reviewer State Switcher:') }}"
                          data-hi="{{ labels_hi.reviewer_state_label|default('रिव्यूअर स्टेट स्विचर:') }}">
                        {{ labels.reviewer_state_label|default("Reviewer State Switcher:") }}
                    </span>
                </div>
                <div class="flex flex-wrap items-center gap-1.5 font-mono">
                    <button type="button"
                            id="btnStateDefault"
                            onclick="setCorridorState('default')"
                            class="px-2 py-0.5 rounded text-[11px] font-bold bg-primary text-on-primary transition-all">
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_state_trucks|default('[Show 3 Trucks]') }}"
                              data-hi="{{ labels_hi.btn_state_trucks|default('[3 ट्रक देखें]') }}">
                            {{ labels.btn_state_trucks|default("[Show 3 Trucks]") }}
                        </span>
                    </button>
                    <button type="button"
                            id="btnStateSkeleton"
                            onclick="setCorridorState('skeleton')"
                            class="px-2 py-0.5 rounded text-[11px] font-bold bg-surface-container-lowest border border-outline-variant hover:bg-surface-container text-primary transition-all">
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_state_skeleton|default('[Loading Skeleton]') }}"
                              data-hi="{{ labels_hi.btn_state_skeleton|default('[लोडिंग स्केलेटन]') }}">
                            {{ labels.btn_state_skeleton|default("[Loading Skeleton]") }}
                        </span>
                    </button>
                    <button type="button"
                            id="btnStateEmpty"
                            onclick="setCorridorState('empty')"
                            class="px-2 py-0.5 rounded text-[11px] font-bold bg-surface-container-lowest border border-outline-variant hover:bg-surface-container text-primary transition-all">
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_state_empty_corridor|default('[0 Results Empty]') }}"
                              data-hi="{{ labels_hi.btn_state_empty_corridor|default('[0 परिणाम रिक्त]') }}">
                            {{ labels.btn_state_empty_corridor|default("[0 Results Empty]") }}
                        </span>
                    </button>
                    <button type="button"
                            id="btnStateCapacity"
                            onclick="setCorridorState('capacity')"
                            class="px-2 py-0.5 rounded text-[11px] font-bold bg-surface-container-lowest border border-outline-variant hover:bg-surface-container text-primary transition-all">
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_state_capacity|default('[Corridor at Capacity]') }}"
                              data-hi="{{ labels_hi.btn_state_capacity|default('[कॉरिडोर फुल]') }}">
                            {{ labels.btn_state_capacity|default("[Corridor at Capacity]") }}
                        </span>
                    </button>
                    <button type="button"
                            id="btnStateError"
                            onclick="setCorridorState('error')"
                            class="px-2 py-0.5 rounded text-[11px] font-bold bg-surface-container-lowest border border-outline-variant hover:bg-surface-container text-primary transition-all">
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_state_error|default('[Error State]') }}"
                              data-hi="{{ labels_hi.btn_state_error|default('[त्रुटि स्थिति]') }}">
                            {{ labels.btn_state_error|default("[Error State]") }}
                        </span>
                    </button>
                </div>
            </div>
        </div>
        <!-- ========================================================================= -->
        <!-- 3. SEARCH BLOCK (3-STEP PROGRESSIVE WIZARD CAROUSEL) -->
        <!-- ========================================================================= -->
        <section class="bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-4 md:p-6 shadow-sm space-y-4"
                 id="search-engine">
            <!-- Header & Stepper Progress -->
            <div class="space-y-3 border-b border-outline-variant/30 pb-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="text-secondary flex items-center">{{ icon("search", size=20) }}</span>
                        <h1 id="corridor-view-title"
                            class="text-base md:text-lg font-bold text-primary lang-text"
                            data-en="{{ labels_en.wizard_title|default('Find Instant Truck Space') }}"
                            data-hi="{{ labels_hi.wizard_title|default('NH48 पर तुरंत ट्रक में स्थान खोजें') }}">
                            {{ labels.wizard_title|default("Find Instant Truck Space") }}
                        </h1>
                    </div>
                    <!-- Minimal Step Indicator "1/3" -->
                    <span class="text-xs font-mono font-bold text-secondary"
                          id="stepCounterText">1/3</span>
                </div>
                <!-- Progress Bar Indicator -->
                <div class="flex items-center gap-2 w-full">
                    <div class="h-1.5 flex-1 rounded-full bg-secondary transition-all duration-300"
                         id="stepProgress1"></div>
                    <div class="h-1.5 flex-1 rounded-full bg-surface-container-high transition-all duration-300"
                         id="stepProgress2"></div>
                    <div class="h-1.5 flex-1 rounded-full bg-surface-container-high transition-all duration-300"
                         id="stepProgress3"></div>
                </div>
            </div>
            <!-- STEP 1: PICKUP & DROP HUB SELECTION -->
            <div class="space-y-4" id="wizardStep1">
                <div class="space-y-3">
                    <!-- Pickup Hub Selection -->
                    <div class="bg-surface-container-low/70 rounded-xl p-3 md:p-4 border border-outline-variant/40 space-y-2.5">
                        <div class="flex items-center justify-between">
                            <label class="text-[11px] font-mono font-bold uppercase tracking-wider text-on-surface-variant flex items-center gap-1">
                                <span class="text-secondary flex items-center">{{ icon("trip_origin", size=14) }}</span>
                                <span class="lang-text"
                                      data-en="{{ labels_en.label_pickup_point|default('Pickup Point') }}"
                                      data-hi="{{ labels_hi.label_pickup_point|default('पिकअप स्थान') }}">
                                    {{ labels.label_pickup_point|default("Pickup Point") }}
                                </span>
                            </label>
                            <span class="text-[10px] font-mono text-secondary font-semibold lang-text"
                                  data-en="{{ labels_en.corridor_name_tag|default('NH48 Corridor') }}"
                                  data-hi="{{ labels_hi.corridor_name_tag|default('NH48 कॉरिडोर') }}">
                                {{ labels.corridor_name_tag|default("NH48 Corridor") }}
                            </span>
                        </div>
                        <button type="button"
                                onclick="simulateLocationClick(this)"
                                class="w-full bg-surface-container-lowest hover:bg-surface-container border border-outline-variant/80 rounded-lg p-3 text-left flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs font-semibold text-primary transition-colors">
                            <span class="flex items-center gap-2">
                                <span class="text-secondary flex items-center shrink-0">{{ icon("my_location", size=18) }}</span>
                                <span class="leading-snug">
                                    <span class="block lang-text"
                                          data-en="{{ labels_en.btn_use_location|default('Use my location for closest hub') }}"
                                          data-hi="{{ labels_hi.btn_use_location|default('निकटतम हब हेतु मेरी लोकेशन चुनें') }}">
                                        {{ labels.btn_use_location|default("Use my location for closest hub") }}
                                    </span>
                                    <span class="block text-[11px] text-on-surface-variant font-normal lang-text"
                                          data-en="{{ labels_en.pickup_detected_hint|default('Sanjay Gandhi Transport Nagar, Delhi (Auto-detected)') }}"
                                          data-hi="{{ labels_hi.pickup_detected_hint|default('संजय गांधी ट्रांसपोर्ट नगर, दिल्ली (स्वतः पहचाना गया)') }}">
                                        {{ labels.pickup_detected_hint|default("Sanjay Gandhi Transport Nagar, Delhi (Auto-detected)") }}
                                    </span>
                                </span>
                            </span>
                            <span class="text-[11px] font-mono text-secondary self-start sm:self-center shrink-0">0.8 km</span>
                        </button>
                        <!-- Quick Hub Selector Pills -->
                        <div class="flex items-center gap-1.5 flex-wrap pt-1 text-[11px] font-mono">
                            <span class="text-on-surface-variant mr-1 lang-text"
                                  data-en="{{ labels_en.quick_hubs_label|default('Popular Pickup Hubs:') }}"
                                  data-hi="{{ labels_hi.quick_hubs_label|default('लोकप्रिय पिकअप हब:') }}">
                                {{ labels.quick_hubs_label|default("Popular Pickup Hubs:") }}
                            </span>
                            <button type="button"
                                    onclick="quickSelectPickup('Delhi (SGTN Bay 4)', this)"
                                    class="quick-hub-btn">
                                <span class="lang-text"
                                      data-en="{{ labels_en.hub_sgtn|default('Delhi (SGTN Bay 4)') }}"
                                      data-hi="{{ labels_hi.hub_sgtn|default('दिल्ली (SGTN बे 4)') }}">
                                    {{ labels.hub_sgtn|default("Delhi (SGTN Bay 4)") }}
                                </span>
                            </button>
                            <button type="button"
                                    onclick="quickSelectPickup('Gurugram (Hero Honda)', this)"
                                    class="quick-hub-btn">
                                <span class="lang-text"
                                      data-en="{{ labels_en.hub_gurugram|default('Gurugram (Hero Honda)') }}"
                                      data-hi="{{ labels_hi.hub_gurugram|default('गुरुग्राम (हीरो होंडा)') }}">
                                    {{ labels.hub_gurugram|default("Gurugram (Hero Honda)") }}
                                </span>
                            </button>
                            <button type="button"
                                    onclick="quickSelectPickup('Manesar IMT Depot', this)"
                                    class="quick-hub-btn">
                                <span class="lang-text"
                                      data-en="{{ labels_en.hub_manesar|default('Manesar IMT Depot') }}"
                                      data-hi="{{ labels_hi.hub_manesar|default('मानेसर IMT डिपो') }}">
                                    {{ labels.hub_manesar|default("Manesar IMT Depot") }}
                                </span>
                            </button>
                        </div>
                    </div>
                    <!-- Drop Hub Selection -->
                    <div class="bg-surface-container-low/70 rounded-xl p-3 md:p-4 border border-outline-variant/40 space-y-2.5">
                        <label class="text-[11px] font-mono font-bold uppercase tracking-wider text-on-surface-variant flex items-center gap-1">
                            <span class="text-primary flex items-center">{{ icon("location_on", size=14) }}</span>
                            <span class="lang-text"
                                  data-en="{{ labels_en.label_drop_destination|default('Drop Destination') }}"
                                  data-hi="{{ labels_hi.label_drop_destination|default('ड्रॉप गंतव्य') }}">
                                {{ labels.label_drop_destination|default("Drop Destination") }}
                            </span>
                        </label>
                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5 bg-surface-container-lowest border border-outline-variant/80 rounded-lg p-3">
                            <div class="flex items-start gap-2.5">
                                <span class="text-primary flex items-center mt-0.5 shrink-0">{{ icon("domain", size=20) }}</span>
                                <div>
                                    <span class="text-xs font-bold text-primary font-mono block"
                                          id="displayDropHub">{{ labels.drop_default_hub|default("Jaipur VKI Depot") }}</span>
                                    <span class="text-[11px] text-on-surface-variant block leading-normal lang-text"
                                          data-en="{{ labels_en.drop_default_address|default('Vishwakarma Road 14 (South Terminal Dock 8)') }}"
                                          data-hi="{{ labels_hi.drop_default_address|default('विश्वकर्मा रोड 14 (साउथ टर्मिनल डॉक 8)') }}">
                                        {{ labels.drop_default_address|default("Vishwakarma Road 14 (South Terminal Dock 8)") }}
                                    </span>
                                </div>
                            </div>
                            <div class="sm:text-right shrink-0 border-t sm:border-t-0 pt-2 sm:pt-0 border-outline-variant/30">
                                <select class="bg-surface-container sm:bg-transparent border border-outline-variant/40 sm:border-0 rounded sm:rounded-none px-2 py-1 sm:p-0 text-secondary text-xs font-mono font-bold focus:ring-0 cursor-pointer w-full sm:w-auto text-left sm:text-right"
                                        id="dropHubSelect"
                                        onchange="updateDropHub(this.value)">
                                    <option selected>Jaipur VKI Depot</option>
                                    <option>Kotputli Node (Drop)</option>
                                    <option>Delhi Depot (Return)</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Step 1 Nav CTA -->
                <button type="button"
                        onclick="goToWizardStep(2)"
                        class="w-full bg-secondary hover:bg-secondary-container active:scale-[0.99] text-on-secondary py-3 px-4 rounded-xl text-sm font-bold tracking-wide transition-all shadow-md flex items-center justify-center gap-2">
                    <span class="lang-text"
                          data-en="{{ labels_en.btn_next_window|default('Next: Select Departure Window') }}"
                          data-hi="{{ labels_hi.btn_next_window|default('आगे: रवानगी समय चुनें') }}">
                        {{ labels.btn_next_window|default("Next: Select Departure Window") }}
                    </span>
                    {{ icon("arrow_forward", size=16) }}
                </button>
            </div>
            <!-- STEP 2: DEPARTURE WINDOW -->
            <div class="space-y-4 hidden" id="wizardStep2">
                <div class="bg-surface-container-low/70 rounded-xl p-3 md:p-4 border border-outline-variant/40 space-y-3">
                    <div class="flex items-center justify-between">
                        <label class="text-[11px] font-mono font-bold uppercase tracking-wider text-on-surface-variant flex items-center gap-1">
                            <span class="text-primary flex items-center">{{ icon("schedule", size=14) }}</span>
                            <span class="lang-text"
                                  data-en="{{ labels_en.label_departure_window|default('Departure Window') }}"
                                  data-hi="{{ labels_hi.label_departure_window|default('रवानगी समय') }}">
                                {{ labels.label_departure_window|default("Departure Window") }}
                            </span>
                        </label>
                        <span class="text-[10px] font-mono text-on-surface-variant lang-text"
                              data-en="{{ labels_en.tonight_priority_badge|default('Tonight priority') }}"
                              data-hi="{{ labels_hi.tonight_priority_badge|default('आज रात प्राथमिकता') }}">
                            {{ labels.tonight_priority_badge|default("Tonight priority") }}
                        </span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 font-mono text-xs">
                        <button type="button"
                                onclick="selectDateWindow(this)"
                                class="date-pill active py-2.5 px-3 text-left sm:text-center font-bold rounded-lg border transition-all bg-primary text-on-primary border-primary shadow-xs flex flex-row sm:flex-col justify-between sm:justify-center items-center">
                            <span class="text-xs leading-tight">
                                <span class="block lang-text"
                                      data-en="{{ labels_en.window_tonight|default('Tonight') }}"
                                      data-hi="{{ labels_hi.window_tonight|default('आज रात') }}">
                                    {{ labels.window_tonight|default("Tonight") }}
                                </span>
                            </span>
                            <span class="text-[11px] opacity-80 font-normal">{{ labels.window_tonight_sub|default("18:00–22:00") }}</span>
                        </button>
                        <button type="button"
                                onclick="selectDateWindow(this)"
                                class="date-pill py-2.5 px-3 text-left sm:text-center font-semibold rounded-lg border border-outline-variant bg-surface-container-lowest text-primary hover:bg-surface-container transition-all flex flex-row sm:flex-col justify-between sm:justify-center items-center">
                            <span class="text-xs leading-tight">
                                <span class="block lang-text"
                                      data-en="{{ labels_en.window_tomorrow|default('Tomorrow') }}"
                                      data-hi="{{ labels_hi.window_tomorrow|default('कल') }}">
                                    {{ labels.window_tomorrow|default("Tomorrow") }}
                                </span>
                            </span>
                            <span class="text-[11px] text-on-surface-variant font-normal">{{ labels.window_tomorrow_sub|default("T+1 Regular") }}</span>
                        </button>
                        <button type="button"
                                onclick="selectDateWindow(this)"
                                class="date-pill py-2.5 px-3 text-left sm:text-center font-semibold rounded-lg border border-outline-variant bg-surface-container-lowest text-primary hover:bg-surface-container transition-all flex flex-row sm:flex-col justify-between sm:justify-center items-center">
                            <span class="text-xs leading-tight">
                                <span class="block lang-text"
                                      data-en="{{ labels_en.window_custom|default('Custom Date') }}"
                                      data-hi="{{ labels_hi.window_custom|default('तारीख चुनें') }}">
                                    {{ labels.window_custom|default("Custom Date") }}
                                </span>
                            </span>
                            <span class="text-[11px] text-on-surface-variant font-normal">{{ labels.window_custom_sub|default("Select Day") }}</span>
                        </button>
                    </div>
                </div>
                <!-- Step 2 Nav CTA Buttons -->
                <div class="flex items-center gap-3">
                    <button type="button"
                            onclick="goToWizardStep(1)"
                            class="w-1/3 bg-surface-container hover:bg-surface-container-high text-primary py-3 px-3 rounded-xl text-xs font-mono font-bold transition-all flex items-center justify-center gap-1.5">
                        {{ icon("arrow_back", size=14) }}
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_wizard_back|default('Back') }}"
                              data-hi="{{ labels_hi.btn_wizard_back|default('पीछे') }}">
                            {{ labels.btn_wizard_back|default("Back") }}
                        </span>
                    </button>
                    <button type="button"
                            onclick="goToWizardStep(3)"
                            class="w-2/3 bg-secondary hover:bg-secondary-container active:scale-[0.99] text-on-secondary py-3 px-4 rounded-xl text-sm font-bold tracking-wide transition-all shadow-md flex items-center justify-center gap-2">
                        <span class="lang-text"
                              data-en="{{ labels_en.btn_next_weight|default('Next: Select Consignment Weight') }}"
                              data-hi="{{ labels_hi.btn_next_weight|default('आगे: वजन चुनें') }}">
                            {{ labels.btn_next_weight|default("Next: Select Consignment Weight") }}
                        </span>
                        {{ icon("arrow_forward", size=16) }}
                    </button>
                </div>
            </div>
            <!-- STEP 3: CONSIGNMENT WEIGHT & SEARCH ACTION -->
            <div class="space-y-4 hidden" id="wizardStep3">
                <div class="bg-surface-container-low/70 rounded-xl p-3 md:p-4 border border-outline-variant/40 space-y-3">
                    <div class="flex items-center justify-between">
                        <label class="text-[11px] font-mono font-bold uppercase tracking-wider text-on-surface-variant flex items-center gap-1">
                            <span class="text-primary flex items-center">{{ icon("scale", size=14) }}</span>
                            <span class="lang-text"
                                  data-en="{{ labels_en.label_consignment_weight|default('Consignment Weight') }}"
                                  data-hi="{{ labels_hi.label_consignment_weight|default('पार्सल वजन') }}">
                                {{ labels.label_consignment_weight|default("Consignment Weight") }}
                            </span>
                        </label>
                        <span class="text-[10px] font-mono text-secondary font-bold lang-text"
                              data-en="{{ labels_en.fair_tariff_badge|default('Per-KG Fair Tariff') }}"
                              data-hi="{{ labels_hi.fair_tariff_badge|default('प्रति-किग्रा उचित दर') }}">
                            {{ labels.fair_tariff_badge|default("Per-KG Fair Tariff") }}
                        </span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 font-mono text-xs">
                        <button type="button"
                                onclick="selectWeightSlab('sm', this)"
                                class="weight-pill active py-2.5 px-2 text-center rounded-lg border border-secondary bg-secondary-fixed text-on-secondary-fixed font-bold shadow-xs transition-all">
                            <span class="font-bold text-xs block">{{ labels.weight_slab_sm_title|default("10–50 kg") }}</span>
                            <span class="text-[11px] text-on-surface-variant lang-text"
                                  data-en="{{ labels_en.weight_slab_sm_desc|default('Standard') }}"
                                  data-hi="{{ labels_hi.weight_slab_sm_desc|default('मानक') }}">
                                {{ labels.weight_slab_sm_desc|default("Standard") }}
                            </span>
                        </button>
                        <button type="button"
                                onclick="selectWeightSlab('md', this)"
                                class="weight-pill py-2.5 px-2 text-center rounded-lg border border-outline-variant bg-surface-container-lowest text-primary hover:bg-surface-container font-semibold transition-all">
                            <span class="font-bold text-xs block">{{ labels.weight_slab_md_title|default("51–250 kg") }}</span>
                            <span class="text-[11px] text-secondary lang-text"
                                  data-en="{{ labels_en.weight_slab_md_desc|default('Commercial ★') }}"
                                  data-hi="{{ labels_hi.weight_slab_md_desc|default('व्यावसायिक ★') }}">
                                {{ labels.weight_slab_md_desc|default("Commercial ★") }}
                            </span>
                        </button>
                        <button type="button"
                                onclick="selectWeightSlab('lg', this)"
                                class="weight-pill py-2.5 px-2 text-center rounded-lg border border-outline-variant bg-surface-container-lowest text-primary hover:bg-surface-container font-semibold transition-all">
                            <span class="font-bold text-xs block">{{ labels.weight_slab_lg_title|default("250 kg+") }}</span>
